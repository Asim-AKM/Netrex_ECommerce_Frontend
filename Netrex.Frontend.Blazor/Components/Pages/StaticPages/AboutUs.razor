            </div>
            <!-- Team Member 3 -->
            <div class="col-sm-6 col-lg-3">
                <div class="team-img-wrapper">
                    <img alt="Muhammad Shehzad" class="team-img" src="\assets\staticpagesassets\images\shehzad.png" />
                    <div class="team-overlay"></div>
                </div>
                <h4 class="h5 fw-bold text-dark mb-1">Muhammad Shehzad</h4>
                <p class="text-netrex-primary fw-medium small">Backend Developer</p>
            </div>
            <!-- Team Member 4 -->
            <div class="col-sm-6 col-lg-3">
                <div class="team-img-wrapper">
                    <img alt="Muhammad Shoaib" class="team-img" src="\assets\staticpagesassets\images\shoaib.png" />
                    <div class="team-overlay"></div>
                </div>
                <h4 class="h5 fw-bold text-dark mb-1">Muhammad Shoaib</h4>
