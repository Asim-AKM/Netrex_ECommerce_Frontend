@page "/account"
@rendermode InteractiveServer
@using Netrex.Frontend.Application.Services.Customer.Implementation 
@using Netrex.Frontend.Application.Services.Customer.Interfaces
@using Netrex.Frontend.Application.DTO_s
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject ICustomerManager CustomerManager
@layout Netrex.Frontend.Blazor.Components.Layout.CustomerLayout.CustomerMainLayout

<div class="dashboard-header">
    <h1>Welcome to Your Dashboard, @userModel.FirstName @userModel.LastName</h1>
    <p>Manage your account and preferences here.</p>
</div>

<div class="quick-access">
    <div class="access-box">
        <i class="fas fa-shopping-cart"></i>
        <h4>Orders</h4>
        <p>View and manage your orders</p>
    </div>
    <div class="access-box">
        <i class="fas fa-credit-card"></i>
        <h4>Payments</h4>
        <p>Manage payment methods</p>
    </div>
    <div class="access-box">
        <i class="fas fa-user"></i>
        <h4>Profile</h4>
        <p>Update your personal information</p>
    </div>
    <div class="access-box">
        <i class="fas fa-cog"></i>
        <h4>Settings</h4>
        <p>Configure your preferences</p>
    </div>
</div>

<div class="personal-info-card">
    <h3>Edit Personal Information</h3>
    <EditForm Model="@userModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="profile-image-container text-center mb-4">
            <div class="image-wrapper">
                <img src="@previewImageUrl" alt="Profile Picture" class="profile-img-preview" />
                <div class="mt-2">
                    <label for="profileUpload" class="btn-link-custom" style="cursor: pointer;">
                        <i class="fas fa-camera"></i> Edit Photo
                    </label>
                    <InputFile id="profileUpload" OnChange="HandleImageSelected" hidden accept="image/*" />
                </div>
            </div>
        </div>

        <div class="form-group mb-3">
            <label for="firstName" class="form-label-custom">First Name</label>
            <InputText id="firstName" class="form-control-custom" @bind-Value="userModel.FirstName" />
        </div>
        <div class="form-group mb-3">
            <label for="lastName" class="form-label-custom">Last Name</label>
            <InputText id="lastName" class="form-control-custom" @bind-Value="userModel.LastName" />
        </div>
        @*  Email aur Phone DTO mein nahi hain isliye sirf UI par nazar aayenge *@
        <div class="form-group mb-3">
            <label for="email" class="form-label-custom">Email</label>
            <InputText id="email" type="email" class="form-control-custom" @bind-Value="userModel.Email" />
        </div>
        <div class="form-group mb-3">
            <label for="phone" class="form-label-custom">Phone</label>
            <InputText id="phone" type="tel" class="form-control-custom" @bind-Value="userModel.Phone" />
        </div>
        <div class="form-group mb-3">
            <label for="address" class="form-label-custom">Address</label>
            <InputTextArea id="address" rows="3" class="form-control-custom" @bind-Value="userModel.Address" />
        </div>
        <button type="submit" class="btn-primary-custom">Update Information</button>
    </EditForm>
</div>

<div class="personal-info-card">
    <h3>Account Security</h3>
    <p>Manage your password and two-factor authentication settings.</p>
    <div class="d-flex flex-column flex-sm-row">
        <button class="btn-primary-custom me-sm-3 mb-2 mb-sm-0" data-bs-toggle="modal" data-bs-target="#passwordModal">Change Password</button>
        <button class="btn-secondary-custom" data-bs-toggle="modal" data-bs-target="#twoFAModal">Enable 2FA</button>
    </div>
</div>

@code {
    private UserModel userModel = new()
    {
        FirstName = "Muhammad",
        LastName = "Shoaib",
        Email = "john@example.com",
        Phone = "+1234567890",
        Address = "123 Main St, City, Country"
    };

    private PasswordModel passwordModel = new();
    private string previewImageUrl = "/assets/clients-images/DaaDu.jpeg";

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var resizedFile = await file.RequestImageFileAsync("image/jpeg", 300, 300);
                using var stream = resizedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var imageData = ms.ToArray();

                previewImageUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(imageData)}";

                // Replace Guid.Empty with real User ID when Auth is ready
                await CustomerManager.UpdateProfileImageAsync(Guid.Empty, imageData);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        // Mapping according to your DTO structure
        var dto = new UpdateCustomerDto
        {
            UserId = Guid.Empty, 
            FirstName = userModel.FirstName,
            LastName = userModel.LastName,
            Address = userModel.Address,
            City = "Default City", // Aap userModel mein city add kar sakte hain
            Country = "Default Country",
            Province = "Default Province"
        };

        try
        {
            await CustomerManager.UpdateCustomerAsync(dto);
            Console.WriteLine("Profile updated successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Update failed: {ex.Message}");
        }
    }

    private void HandlePasswordSubmit() => Console.WriteLine("Password changed");

    public class UserModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }

    public class PasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}