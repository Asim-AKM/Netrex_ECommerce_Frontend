@page "/"
@using Netrex.Frontend.Application.Services.ProductManagement.Interfaces
@using Netrex.Frontend.Application.ViewModels.ProductManagement
@inject IJSRuntime JS
@inject IProductManager ProductManager
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<div class="home-page">
    <!-- Slider -->
    <div class="slide-container">
        <div class="slide">
            <img src="assets/images/home1-slider-1.jpg" alt="" />
            <div class="caption">
                <h2>Pakistan's Smart Shopping Destination</h2>
                <p>Your one-stop online store for authentic products, easy returns, and nationwide delivery.</p>
                <button>Explore Now</button>
            </div>
        </div>
        <div class="slide">
            <img src="assets/images/home1-slider-3.jpg" alt="" />
            <div class="caption">
                <h2>Best Products at Best Prices</h2>
                <p>Premium quality products without the premium price tag.</p>
                <button>Explore Now</button>
            </div>
        </div>
        <span class="arrow prev" onclick="slideControler(-1)">&#10094;</span>
        <span class="arrow next" onclick="slideControler(1)">&#10095;</span>
    </div>

    <!-- Categories -->
    @if (isLoadingCategories)
    {
        <p>Loading categories...</p>
    }
    else if (categories != null && categories.Any())
    {
        <section class="categories my-5">
            <div class="container">
                <div class="row justify-content-around text-center">
                    @foreach (var category in categories)
                    {
                        <div class="col-6 col-sm-4 col-md-3 col-lg-auto mb-4 mb-lg-0">
                            <a @onclick="() => LoadProductsAsync(category.Id)">
                                <div class="catg">
                                    <img src="@category.IconUrl" width="50" />

                                    <p>@category.ProductCategoryName</p>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else
    {
        <p>No categories found</p>
    }
    <!-- Products Section -->
    <section class="product-list py-4">
        <div class="container">
            <h2 class="featured">Featured Products</h2>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading products...</p>
                </div>
            }
            else if (products == null || products.Count == 0)
            {
                <div class="text-center py-5">
                    <p class="text-muted">No products available at the moment.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var product in products)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
                            <div class="product-card h-100 d-flex flex-column">
                                <div class="product-image">
                                    @if (product.Discount > 0)
                                    {
                                        <span class="discount">-@product.Discount%</span>
                                    }
                                    <span class="wishlist"
                                          style="font-size:25px; cursor:pointer;"
                                          @onclick="() => ToggleWishList(product.ProductId)"
                                          @onclick:stopPropagation="true">

                                        @if (_loadingWishIds.Contains(product.ProductId))
                                        {
                                            <span class="spinner-border spinner-border-sm"
                                                  style="width:16px; height:16px; color:#e74c3c;"></span>
                                        }
                                        else if (_wishedProducts.ContainsKey(product.ProductId))
                                        {
                                            <span style="color:#e74c3c; font-size:25px;">&#9829;</span>
                                        }
                                        else
                                        {
                                            <span style="color:#ccc; font-size:25px;">&#9825;</span>
                                        }

                                    </span>
                                    <img src="@(product.ImageUrl ?? "/assets/placeholder.jpg")"
                                         alt="@product.ProductName"
                                         onerror="this.src='/assets/placeholder.jpg'" />
                                </div>
                                <div class="product-info flex-grow-1 d-flex flex-column">
                                    <a href="">
                                        <h3 class="product-title">@product.ProductName</h3>
                                    </a>

                                    <div class="price mt-auto">
                                        @if (product.Discount > 0)
                                        {
                                            var finalPrice = product.Price - (product.Price * product.Discount / 100);
                                            <span style="text-decoration: line-through; color: #999; margin-right: 5px;">Rs @product.Price.ToString("N0")</span>
                                            <span style="color: #04ADB1;">Rs @finalPrice.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span>Rs @product.Price.ToString("N0")</span>
                                        }
                                    </div>
                                    <div class="cart-row mt-3">
                                        <button class="add-cart" @onclick="() => AddToCart(product.ProductId)">
                                            Add to Cart
                                        </button>
                                        <button class="buy-now" @onclick="() => BuyNow(product.ProductId)">
                                            Buy Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
                 <div aria-label="Product navigation" class="mt-5 mb-4">
                    <ul class="pagination justify-content-center custom-unique-pagination">
                        <li class="page-item">
                            @* <a class="page-link nav-text" href="#">&lsaquo; Back</a> *@
                        <button class="page-link nav-text" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                            &lsaquo; Back
                        </button>
                        </li>
                        <li class="page-item">
                            @* <a class="page-link nav-text" href="#">Next</a> *@
                        <button class="page-link nav-text" @onclick="NextPage">
                            Next &rsaquo;
                        </button>
                        </li>
                    </ul>
                </div> 
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="netrex-guidence py-5">
        <div class="container">
            <h2 class="choose-us">Why Choose Us</h2>
            <div class="row mt-4 justify-content-center">
                <div class="col-12 col-sm-6 col-md-6 col-lg-3 mb-4">
                    <div class="netrex">
                        <img src="assets/icons/express-delivery.png" width="70" alt="" />
                        <div class="netrex-content">
                            <h2 class="h5">Fast Delivery</h2>
                            <p>Get your products delivered quickly and reliably, so you can enjoy them without any delay.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-6 col-lg-3 mb-4">
                    <div class="netrex">
                        <img src="assets/icons/wallet.png" width="70" alt="" />
                        <div class="netrex-content">
                            <h2 class="h5">Secure Payment</h2>
                            <p>Shop with confidence knowing that all your transactions are fully encrypted and safe.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-6 col-lg-3 mb-4">
                    <div class="netrex">
                        <img src="assets/icons/product-return.png" width="70" alt="" />
                        <div class="netrex-content">
                            <h2 class="h5">Easy Returns</h2>
                            <p>Changed your mind? Our simple and convenient return process makes it stress-free.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-6 col-lg-3 mb-4">
                    <div class="netrex">
                        <img src="assets/icons/24-7.png" width="70" alt="" />
                        <div class="netrex-content">
                            <h2 class="h5">24/7 Support</h2>
                            <p>Have a question or need assistance? Our friendly support team is available around the clock.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Reviews -->
    <section class="reviews-comments">
        <div class="review">
            <img src="" class="cust-image" alt="" />
            <div class="review-content">
                <p id="user-review"></p>
                <p class="user-name"></p>
            </div>
        </div>
        <div class="arrow">
            <button class="left-arrow"><img src="assets/icons/left-arrow.png" alt=""></button>
            <button class="right-arrow"><img src="assets/icons/right-arrow.png" alt=""></button>
        </div>
    </section>
</div>

