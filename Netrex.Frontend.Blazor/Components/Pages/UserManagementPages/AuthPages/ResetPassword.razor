@page "/reset-password"
@using System.Text.RegularExpressions
@using System.Timers
@implements IDisposable

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Secure your account with a strong password.</p>
        </div>
        <div class="auth-right">
            <h2>New Password</h2>
            <p class="small text-muted">Resetting for: <b>@Email</b></p>

            <div class="mb-3">
                <div class="input-group">
                    <span class="icon">
                        <img src="assets/user-management-assets/icons/User Male Ganja.png" alt="user" />
                    </span>
                    <input type="text"
                           value="@Otp"
                           @oninput="HandleOtpInput"
                           class="form-control @(ActiveErrorField == "otp" ? "is-invalid" : "")"
                           placeholder="Enter 6-Digit OTP" maxlength="6" />
                </div>
                @if (ActiveErrorField == "otp")
                {
                    <small class="text-danger d-block mt-1">@ErrorMessage</small>
                }

                @if (!IsSuccess)
                {
                    <div class="d-flex justify-content-between mt-1">
                        @if (!IsTimerExpired)
                        {
                            <small class="text-muted">OTP expires in: <b>@TimerText</b></small>
                        }
                        else
                        {
                            <div class="w-100 d-flex justify-content-between align-items-center">
                                <small class="text-danger fw-bold">OTP Expired!</small>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="ResendOtp">Resend OTP</button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="mb-3">
                <div class="input-group">
                    <span class="icon">
                        <img src="assets/user-management-assets/icons/Lock black.png" alt="lock" />
                    </span>
                    <input type="@passwordType" @bind="NewPassword" @bind:event="oninput" @onkeyup="ValidateWaterfall"
                           class="form-control @(ActiveErrorField == "password" ? "is-invalid" : "")" placeholder="New Password" />
                    <span class="toggle-password" style="cursor:pointer; padding: 5px; background: #eee; border-radius: 0 4px 4px 0;" @onclick="TogglePassword">
                        <img src="@eyeIcon" style="height:20px" alt="eye" />
                    </span>
                </div>
                @if (ActiveErrorField == "password")
                {
                    <small class="text-danger">@ErrorMessage</small>
                }
            </div>

            <div class="mb-3">
                <div class="input-group">
                    <span class="icon">
                        <img src="assets/user-management-assets/icons/Lock black.png" alt="lock" />
                    </span>
                    <input type="password" @bind="ConfirmPassword" @bind:event="oninput" @onkeyup="ValidateWaterfall"
                           class="form-control @(ActiveErrorField == "confirm" ? "is-invalid" : "")" placeholder="Confirm Password" />
                </div>
                @if (ActiveErrorField == "confirm")
                {
                    <small class="text-danger">@ErrorMessage</small>
                }
            </div>

            @if (IsSuccess)
            {
                <div class="alert alert-success py-2 shadow-sm">✅ Success! Redirecting...</div>
            }

            <button class="btn btn-primary w-100 py-2 mt-2" @onclick="HandleReset" disabled="@(IsProcessing || IsSuccess)">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <span>Reset Password</span>
                }
            </button>
        </div>
    </div>
</div>