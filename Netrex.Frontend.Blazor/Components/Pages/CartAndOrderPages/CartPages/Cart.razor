@page "/cart"
<main class="container cart-container">
    <h1 class="cart-title">Shopping Cart</h1>

    <section class="cart-wrapper">

        <!-- Cart Items Section -->
        <section class="cart-items" aria-label="Shopping Cart Items">

            @if (cartState.Items.Any())
            {
                @foreach (var item in cartState.Items)
                {
                    <article class="cart-item" data-id="@item.ProductId">
                        <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "https://picsum.photos/100/120")"
                             alt="@item.ProductName" width="100" height="120" />
                        <div class="item-info">
                            <h2>@item.ProductName</h2>
                        </div>
                        <div class="item-price">@($"Rs {item.Price:N0}")</div>
                        <div class="qty-box">
                            <button class="qty-decrease"
                                    @onclick="() => DecreaseQuantity(item)"
                                    disabled="@(item.Quantity <= 1)">
                                -
                            </button>
                            <span class="qty">@item.Quantity</span>
                            <button class="qty-increase"
                                    @onclick="() => IncreaseQuantity(item)">
                                +
                            </button>
                        </div>
                        <div class="item-total">@($"Rs {item.SubTotal:N0}")</div>
                        <button class="remove" @onclick="() => RemoveItem(item)">Remove</button>
                    </article>
                }
            }
            else
            {
                <p>Your shopping cart is empty.</p>
            }

        </section>

        <!-- Order Summary Section -->
        <aside class="summary" aria-label="Order Summary">
            <h2>Order Summary</h2>

            <div class="summary-row">
                <span>Subtotal</span>
                <span>@($"Rs {Subtotal:N0}")</span>
            </div>

            <div class="summary-row">
                <span>Shipping</span>
                <span>@($"Rs {Shipping:N0}")</span>
            </div>

            <div class="summary-row total">
                <span>Total</span>
                <span>@($"Rs {Total:N0}")</span>
            </div>

            <button class="checkout-btn"
                    @onclick="ProceedToCheckOut"
                    disabled="@(!cartState.Items.Any())">
                Proceed to Checkout
            </button>
            <a href="/shop" class="continue-btn">Continue Shopping</a>
        </aside>

    </section>
</main>
