@using Netrex.Frontend.Application.Commons.Enums
@using Netrex.Frontend.Application.Services.Common
@using Netrex.Frontend.Application.ViewModels.Common
@implements IDisposable
@inject ToastService _toastService
@inject IJSRuntime JSRuntime

<div class="toast-wrapper" role="region" aria-label="Notifications" aria-live="polite" aria-atomic="false">
    @foreach (var toast in ActiveToasts.Values)
    {
        <div class="toast-container @toast.Message.Type.ToString().ToLower() @(toast.IsExiting ? "toast-exiting" : "")"
             @key="toast.Message.Id"
             role="alert"
             aria-live="assertive"
             aria-atomic="true"
             tabindex="0"
             @onkeydown="@((e) => HandleKeyDown(e, toast.Message.Id))"
             @onmouseenter="() => PauseToast(toast)"
             @onmouseleave="() => ResumeToast(toast)">

            <div class="toast-icon" aria-hidden="true">
                @if (!string.IsNullOrEmpty(toast.Message.IconClass))
                {
                    <i class="@toast.Message.IconClass"></i>
                }
                else
                {
                    var iconClass = GetIconClass(toast.Message.Type);
                    if (!string.IsNullOrEmpty(iconClass))
                    {
                        <i class="@iconClass"></i>
                    }
                    else
                    {
                        @GetDefaultIcon((ToastType)toast.Message.Type)
                    }
                }
            </div>

            <div class="toast-content">
                <strong class="toast-title" id="toast-title-@toast.Message.Id">@toast.Message.Title</strong>
                <p id="toast-message-@toast.Message.Id">@toast.Message.Message</p>
            </div>

            <button class="toast-close"
                    type="button"
                    aria-label="Close notification"
                    @onclick="() => RemoveToast(toast.Message.Id)"
                    @onclick:stopPropagation="true">
                ×
            </button>

            <div class="toast-progress-container" aria-hidden="true">
                <div class="toast-progress-bar"
                     style="animation-duration: @(toast.Message.Duration)ms;">
                </div>
            </div>
        </div>
    }
</div>


