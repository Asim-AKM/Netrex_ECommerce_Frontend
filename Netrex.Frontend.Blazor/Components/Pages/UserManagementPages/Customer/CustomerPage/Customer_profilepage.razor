@page "/account"
@rendermode InteractiveServer
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<div class="dashboard-header">
    <h1>Welcome to Your Dashboard, Muhammad Shoaib</h1>
    <p>Manage your account and preferences here.</p>
</div>

<div class="quick-access">
    <div class="access-box">
        <i class="fas fa-shopping-cart"></i>
        <h4>Orders</h4>
        <p>View and manage your orders</p>
    </div>
    <div class="access-box">
        <i class="fas fa-credit-card"></i>
        <h4>Payments</h4>
        <p>Manage payment methods</p>
    </div>
    <div class="access-box">
        <i class="fas fa-user"></i>
        <h4>Profile</h4>
        <p>Update your personal information</p>
    </div>
    <div class="access-box">
        <i class="fas fa-cog"></i>
        <h4>Settings</h4>
        <p>Configure your preferences</p>
    </div>
</div>

<div class="personal-info-card">
    <h3>Edit Personal Information</h3>
    <EditForm Model="@userModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group mb-3">
            <label for="firstName" class="form-label-custom">First Name</label>
            <InputText id="firstName" class="form-control-custom" @bind-Value="userModel.FirstName" />
        </div>
        <div class="form-group mb-3">
            <label for="lastName" class="form-label-custom">Last Name</label>
            <InputText id="lastName" class="form-control-custom" @bind-Value="userModel.LastName" />
        </div>
        <div class="form-group mb-3">
            <label for="email" class="form-label-custom">Email</label>
            <InputText id="email" type="email" class="form-control-custom" @bind-Value="userModel.Email" />
        </div>
        <div class="form-group mb-3">
            <label for="phone" class="form-label-custom">Phone</label>
            <InputText id="phone" type="tel" class="form-control-custom" @bind-Value="userModel.Phone" />
        </div>
        <div class="form-group mb-3">
            <label for="address" class="form-label-custom">Address</label>
            <InputTextArea id="address" rows="3" class="form-control-custom" @bind-Value="userModel.Address" />
        </div>
        <button type="submit" class="btn-primary-custom">Update Information</button>
    </EditForm>
</div>

<div class="personal-info-card">
    <h3>Account Security</h3>
    <p>Manage your password and two-factor authentication settings.</p>
    <div class="d-flex flex-column flex-sm-row">
        <button class="btn-primary-custom me-sm-3 mb-2 mb-sm-0" data-bs-toggle="modal" data-bs-target="#passwordModal">Change Password</button>
        <button class="btn-secondary-custom" data-bs-toggle="modal" data-bs-target="#twoFAModal">Enable 2FA</button>
    </div>
</div>

<!-- Password Change Modal -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passwordModalLabel">Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@passwordModel" OnValidSubmit="HandlePasswordSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">Current Password</label>
                        <InputText id="currentPassword" type="password" class="form-control" @bind-Value="passwordModel.CurrentPassword" />
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <InputText id="newPassword" type="password" class="form-control" @bind-Value="passwordModel.NewPassword" />
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="passwordModel.ConfirmPassword" />
                    </div>
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- 2FA Modal -->
<div class="modal fade" id="twoFAModal" tabindex="-1" aria-labelledby="twoFAModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="twoFAModalLabel">Enable 2FA</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Two-factor authentication adds an extra layer of security to your account.</p>
                <button class="btn btn-primary">Enable 2FA</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

@code {
    private UserModel userModel = new UserModel
    {
        FirstName = "Muhammad",
        LastName = "Shoaib",
        Email = "john@example.com",
        Phone = "+1234567890",
        Address = "123 Main St, City, Country"
    };

    private PasswordModel passwordModel = new PasswordModel();

    private void HandleValidSubmit()
    {
        // Handle form submission
        Console.WriteLine("User information updated");
    }

    private void HandlePasswordSubmit()
    {
        // Handle password change
        Console.WriteLine("Password changed");
    }

    public class UserModel
    {
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public string Email { get; set; }
        public string Phone { get; set; }
        public string Address { get; set; }
    }

    public class PasswordModel
    {
        public string CurrentPassword { get; set; }
        public string NewPassword { get; set; }
        public string ConfirmPassword { get; set; }
    }
}