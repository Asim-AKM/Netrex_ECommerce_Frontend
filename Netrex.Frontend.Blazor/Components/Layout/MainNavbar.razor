@using Microsoft.AspNetCore.Http
@inject IJSRuntime JS

<nav>
    <div class="container-fluid">
        <div class="row align-items-center justify-content-between">

            <!-- Hamburger Toggler - Shows below 1024px -->
            <div class="col-auto d-lg-none">
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#navbarOffcanvas"
                        aria-controls="navbarOffcanvas">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- Desktop Navigation -->
            <div class="col-lg-8 col-md-7 d-none d-lg-block">
                <ul class="nav-items d-flex gap-2 mb-0 justify-content-center">
                    <li>
                        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
                    </li>
                    <li><span class="disabled-link">Shop</span></li>
                    <li><span class="disabled-link">About Us</span></li>
                    <li><span class="disabled-link">Blog</span></li>
                    <li><span class="disabled-link">Contact Us</span></li>
                </ul>
            </div>

            <!-- Icons + Seller Button -->
            <div class="col-auto ms-auto">
                <div class="nav-icons">
                    <ul class="d-flex gap-3 mb-0 align-items-center justify-content-end">

                        <!-- Login -->
                        <li>
                            <NavLink href="/login"
                                     data-bs-toggle="tooltip"
                                     data-bs-placement="bottom"
                                     title="Login">
                                <img src="/assets/icons/people.png" width="32" alt="Login" />
                            </NavLink>
                        </li>

                        <!-- Wishlist -->
                        <li>
                            <a href="javascript:void(0)"
                               data-bs-toggle="tooltip"
                               data-bs-placement="bottom"
                               title="Wishlist">
                                <img src="/assets/icons/love.png" width="28" alt="Wishlist" />
                            </a>
                        </li>

                        <!-- Cart -->
                        <li class="cart">
                            <a href="javascript:void(0)"
                               data-bs-toggle="tooltip"
                               data-bs-placement="bottom"
                               title="Shopping Cart">
                                <img src="/assets/icons/shopping-bag.png" width="30" alt="Cart" />
                            </a>
                            <div class="cart-count">
                                <p class="counter mb-0"></p>
                            </div>
                        </li>

                        <!-- Become a Seller -->
                        <li>
                            <a href="/sellerregister"
                               data-bs-toggle="tooltip"
                               data-bs-placement="bottom"
                               title="Become a Seller">
                                <img src="/assets/icons/seller.png" width="30" alt="Become a Seller" />
                            </a>
                        </li>

                    </ul>
                </div>
            </div>

        </div>
    </div>

    <!-- Mobile Offcanvas Menu -->
    <div class="offcanvas offcanvas-start"
         tabindex="-1"
         id="navbarOffcanvas"
         aria-labelledby="navbarOffcanvasLabel">

        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="navbarOffcanvasLabel">Menu</h5>
            <button type="button" class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close"></button>
        </div>

        <div class="offcanvas-body">
            <ul class="nav-items-mobile">
                <li><NavLink href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                <li><span class="disabled-link">Shop</span></li>
                <li><span class="disabled-link">About Us</span></li>
                <li><span class="disabled-link">Blog</span></li>
                <li><span class="disabled-link">Contact Us</span></li>
            </ul>
        </div>
    </div>
</nav>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize Bootstrap tooltips
            await JS.InvokeVoidAsync("eval", @"
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle=""tooltip""]'));
                var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            ");
        }
    }
}