                            <td>#ORD-002</td>
                            <td>Jane Smith</td>
                            <td>$89.50</td>
                            <td><span class="badge badge-shipped">Shipped</span></td>
                            <td>Dec 21, 2024</td>
                            <td><button class="btn-sm btn-view">View</button></td>
                        </tr>
                        <tr>
                            <td>#ORD-003</td>
                            <td>Mike Johnson</td>
                            <td>$249.99</td>
                            <td><span class="badge badge-processing">Processing</span></td>
                            <td>Dec 22, 2024</td>
