                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#ORD-001</td>
                            <td>John Doe</td>
                            <td>$129.99</td>
                            <td><span class="badge badge-delivered">Delivered</span></td>
                            <td>Dec 20, 2024</td>
                            <td><button class="btn-sm btn-view">View</button></td>
                        </tr>
