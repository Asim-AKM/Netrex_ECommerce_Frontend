@using Netrex.Frontend.Blazor.Components.Pages.Customer
@inherits LayoutComponentBase

<!-- Customer Module Files -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/customerassets/CustomerProfile.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="/assets/customerassets/CustomerProfile.js"></script>

<div class="customer-layout-root">
    <!-- Header (optional) -->
    <CustomerHeader />
    
    <!-- Sidebar + Main Content Row -->
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Column -->
            <div class="col-md-3 col-lg-2 d-none d-md-block p-0">
                <CustomerSidebar />
            </div>
            
            <!-- Main Content Column -->
            <div class="col-md-9 col-lg-10 ms-sm-auto customer-main-content">
                <!-- Mobile Header -->
                <div class="d-md-none customer-mobile-header py-3 px-3">
                    <button class="btn customer-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#customerMobileMenu">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
                
                <!-- Mobile Offcanvas Menu -->
                <div class="offcanvas offcanvas-start" tabindex="-1" id="customerMobileMenu">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                    </div>
                    <div class="offcanvas-body">
                        <CustomerSidebar IsMobile="true" />
                    </div>
                </div>
                
                <!-- Page Content Renders Here -->
                <div class="customer-content-wrapper p-4">
                    @Body
                </div>
            </div>
        </div>
    </div>
    
    <!-- Footer (optional) -->
    <CustomerFooter />
</div>