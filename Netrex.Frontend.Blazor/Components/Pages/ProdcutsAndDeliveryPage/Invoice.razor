@page "/invoicePage"
@* @rendermode InteractiveServer *@

<div class="invoice-page">

    <div class="invoice-paper">

        <!-- HEADER -->
        <div class="invoice-header">
            <div class="brand">
                <h2>Netrex Store</h2>
                <p>Online Shopping Platform</p>
                <p>support@netrex.com</p>
            </div>

            <div class="invoice-meta">
                <strong>INVOICE</strong>
                Invoice #: INV-10234<br />
                Date: 28 Jan 2026<br />
                Payment: Cash on Delivery
            </div>
        </div>

        <!-- ADDRESSES -->
        <div class="address-section">
            <div class="address-box">
                <h4>Billed To</h4>
                Ahmed Khan<br />
                +92 300 1234567<br />
                DHA Phase 6, Lahore<br />
                Punjab, Pakistan
            </div>

            <div class="address-box">
                <h4>Shipped To</h4>
                Ahmed Khan<br />
                House #123, Street #45<br />
                DHA Phase 6, Lahore
            </div>
        </div>

        <!-- ITEMS -->
        <table class="table table-borderless">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Wireless Headphones</td>
                    <td>1</td>
                    <td>Rs. 5,000</td>
                    <td>Rs. 5,000</td>
                </tr>
                <tr>
                    <td>Smart Watch</td>
                    <td>2</td>
                    <td>Rs. 3,000</td>
                    <td>Rs. 6,000</td>
                </tr>
            </tbody>
        </table>

        <!-- TOTALS -->
        <div class="totals">
            <div>
                <span>Subtotal</span>
                <span>Rs. 11,000</span>
            </div>
            <div>
                <span>Delivery</span>
                <span>Rs. 250</span>
            </div>
            <div class="grand-total">
                <span>Total</span>
                <span>Rs. 11,250</span>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="invoice-footer">
            <i class="bi bi-shield-check"></i>
            Thank you for shopping with Netrex. This is a system generated invoice.
        </div>

    </div>

</div>
