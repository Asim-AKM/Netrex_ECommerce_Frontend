                </div>
                <div class="modal-body">
                    @if (selectedProduct != null)
                    {
                        <div class="row">
                            <div class="col-md-5 text-center mb-3 mb-md-0">
                                <div class="border rounded p-3 bg-light">
                                    <img src="@(selectedProduct.ImageUrl ?? "/assets/placeholder.jpg")"
                                         alt="@selectedProduct.ProductName"
                                         style="max-width: 100%; max-height: 250px; object-fit: contain;"
                                         onerror="this.src='/assets/placeholder.jpg'">
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="product-details-info">
                                    <h4 class="mb-3">@selectedProduct.ProductName</h4>
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <th style="width: 35%; background-color: #f8f9fa; padding: 8px;">Description:</th>
                                            <td style="padding: 8px;">@selectedProduct.ProductDescription</td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Price:</th>
                                            <td style="padding: 8px; color: #04ADB1; font-weight: bold; font-size: 1.2rem;">Rs. @selectedProduct.Price.ToString("N0")</td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Discount:</th>
                                            <td style="padding: 8px;">@selectedProduct.Discount%</td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Category:</th>
                                            <td style="padding: 8px;"><span class="badge bg-info">@selectedProduct.CategoryName</span></td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Stock:</th>
                                            <td style="padding: 8px;">
                                                @if (selectedProduct.StockQuantity > 0)
                                                {
                                                    <span class="badge bg-success">@selectedProduct.StockQuantity units available</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Out of stock</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted">Product not found</p>
                    }
                </div>
                <div class="modal-footer">
                    @if (selectedProduct != null)
                    {
                        <button class="btn btn-primary" @onclick="EditFromViewModal">
                            <i class="fas fa-edit"></i> Edit Product
                        </button>
                        <button class="btn btn-danger" @onclick="DeleteFromViewModal">
                            <i class="fas fa-trash"></i> Delete Product
                        </button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseViewModal">
                        <i class="fas fa-times"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ EDIT PRODUCT MODAL - FINAL FIXED ============ -->
@if (showEditModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="fas fa-edit me-2"></i>
                        Edit Product
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    @if (_editModel != null)
                    {
                        <EditForm Model="_editModel" OnValidSubmit="UpdateProduct">
                            <DataAnnotationsValidator />

                            <!-- Hidden Guid -->
                            <input type="hidden" @bind-value="_editModel.ProductId" />

                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Product Name</label>
                                <InputText class="form-control" @bind-Value="_editModel.ProductName" />
                                <ValidationMessage For="@(() => _editModel.ProductName)" />
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <InputText class="form-control" @bind-Value="_editModel.ProductDescription" />
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label fw-bold">Price (Rs.)</label>
                                        <InputNumber class="form-control" @bind-Value="_editModel.Price" step="0.01" />
                                        <ValidationMessage For="@(() => _editModel.Price)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label fw-bold">Discount (%)</label>
                                        <InputNumber class="form-control" @bind-Value="_editModel.Discount" step="0.01" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Category</label>
                                <InputSelect class="form-control" @bind-Value="_editModel.CategoryName">
                                    <option value="">-- Select Category --</option>
                                    <option value="Electronics">Electronics</option>
                                    <option value="Clothing">Clothing</option>
                                    <option value="Books">Books</option>
                                    <option value="Sports">Sports</option>
                                    <option value="Home & Kitchen">Home & Kitchen</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _editModel.CategoryName)" />
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Stock Quantity</label>
                                <InputNumber class="form-control" @bind-Value="_editModel.StockQuantity" />
                                <ValidationMessage For="@(() => _editModel.StockQuantity)" />
                            </div>

                            @if (!string.IsNullOrEmpty(_editModel.ImageUrl))
                            {
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Current Image</label>
                                    <div class="border rounded p-2 bg-light">
                                        <img src="@_editModel.ImageUrl" style="max-width: 100%; max-height: 80px;" class="rounded" />
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(EditErrorMessage))
                            {
                                <div class="alert alert-danger">@EditErrorMessage</div>
                            }

                            <div class="modal-footer px-0 pb-0">
                                <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                                <button type="submit" class="btn btn-warning" disabled="@isUpdating">
                                    @if (isUpdating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="fas fa-save"></i> @(isUpdating ? "Updating..." : "Update Product")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ DELETE CONFIRMATION MODAL ============ -->
@if (showDeleteModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-trash me-2"></i>
                        Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    @if (selectedProduct != null)
                    {
                        <div class="text-center mb-4">
                            <img src="@(selectedProduct.ImageUrl ?? "/assets/placeholder.jpg")"
                                 alt="@selectedProduct.ProductName"
                                 style="max-width: 120px; max-height: 120px; border-radius: 8px; border: 1px solid #dee2e6; padding: 5px;">
                        </div>
                        <p class="text-center fs-5">Are you sure you want to delete <strong class="text-danger">@selectedProduct.ProductName</strong>?</p>
                        <p class="text-center text-muted">This action cannot be undone!</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteProduct" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fas fa-trash"></i> @(isDeleting ? "Deleting..." : "Delete Permanently")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ SUCCESS MODAL ============ -->
@if (IsSuccessModalVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-success">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-check-circle me-2"></i>
                        Success
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideSuccessModal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0 fs-5">@Message</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ============ EXISTING CODE ============
    private bool IsModalVisible = false;
    private bool IsSuccessModalVisible = false;
    private bool isSaving = false;
    private List<ProductsVm> products = new();
    private bool isLoadingProducts = false;

    ProductsVm _model = new();
    List<byte[]> ImageBytesList = new();
    List<string> ImageNames = new();
    List<string> ImagePreviews = new();

    string? ErrorMessage;
    string Message = "";

    const long MaxFileSize = 2_621_440;
    const int MaxFiles = 5;

    void ShowModal() => IsModalVisible = true;

    void HideModal()
    {
        IsModalVisible = false;
        _model = new ProductsVm();
        ImageBytesList.Clear();
        ImageNames.Clear();
        ImagePreviews.Clear();
        ErrorMessage = null;
    }

    void HideSuccessModal()
    {
        IsSuccessModalVisible = false;
        Message = "";
    }

    void RemoveImage(int index)
    {
        if (index >= 0 && index < ImageBytesList.Count)
        {
            ImageBytesList.RemoveAt(index);
            ImageNames.RemoveAt(index);
            ImagePreviews.RemoveAt(index);
        }
    }

    async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var files = e.GetMultipleFiles(MaxFiles);
        if (files.Count + ImageBytesList.Count > MaxFiles)
        {
            ErrorMessage = $"Maximum {MaxFiles} images allowed.";
            return;
        }
        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                ErrorMessage = $"Image {file.Name} is larger than 2.5MB.";
                continue;
            }
            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ImageBytesList.Add(ms.ToArray());
            ImageNames.Add(file.Name);
            ImagePreviews.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            isLoadingProducts = true;
            StateHasChanged();
            var response = await ProductManager.GetAllProductsAsync();
            if (response.IsSuccess)
            {
                products = response.Data ?? new();
                Console.WriteLine($"✅ {products.Count} products loaded");
                await JSRuntime.InvokeVoidAsync("updateActiveProductsCount", products.Count);
            }
            else
            {
                Console.WriteLine($"❌ Failed: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error: {ex.Message}");
        }
        finally
        {
            isLoadingProducts = false;
            StateHasChanged();
        }
    }

    async Task SaveProduct()
    {
        if (!ImageBytesList.Any())
        {
            ErrorMessage = "Please upload at least one image.";
            return;
        }
        try
        {
            isSaving = true;
            StateHasChanged();
            var result = await ProductManager.AddProducts(_model, ImageBytesList, ImageNames);
            if (result.IsSuccess)
            {
                await LoadProductsAsync();
                Message = "Product saved successfully ✅";
                HideModal();
                IsSuccessModalVisible = true;
            }
            else
            {
                ErrorMessage = result.Message ?? "Something went wrong ❌";
            }
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ============ FIXED VIEW/EDIT/DELETE CODE ============
    private ProductsVm? selectedProduct = null;
    private bool showViewModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private bool isUpdating = false;
    private string? EditErrorMessage;
    private ProductsVm _editModel = new();

    // ============ VIEW PRODUCT ============
    private void ViewProduct(Guid productId)
    {
        Console.WriteLine($"ViewProduct called with ID: {productId}");
        selectedProduct = products.FirstOrDefault(p => p.ProductId == productId);
        if (selectedProduct != null)
        {
            Console.WriteLine($"Product found: {selectedProduct.ProductName}");
            showViewModal = true;
            StateHasChanged();
        }
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        StateHasChanged();
    }

    // ============ EDIT PRODUCT - FINAL FIXED: SAB FIELDS SHOW HONGE ============
    private void EditProduct(string publicId)
    {
        Console.WriteLine($"EditProduct called with PublicId: {publicId}");
        var product = products.FirstOrDefault(p => p.CloudPublicId == publicId);
        if (product != null)
        {
            selectedProduct = product;

            // 🔴 IMPORTANT: NAYA MODEL BANAO AUR HAR FIELD ASSIGN KARO
            _editModel = new ProductsVm();
            _editModel.ProductId = product.ProductId;
            _editModel.ProductName = product.ProductName ?? string.Empty;
            _editModel.ProductDescription = product.ProductDescription ?? string.Empty;
            _editModel.Price = product.Price;
            _editModel.Discount = product.Discount;
            _editModel.CategoryName = product.CategoryName ?? string.Empty;
            _editModel.StockQuantity = product.StockQuantity;
            _editModel.ImageUrl = product.ImageUrl ?? string.Empty;
            _editModel.CloudPublicId = product.CloudPublicId ?? string.Empty;

            Console.WriteLine($"✅ Edit Product Loaded: {_editModel.ProductName}, Price: {_editModel.Price}, Category: {_editModel.CategoryName}, Stock: {_editModel.StockQuantity}");

            showEditModal = true;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"❌ Product not found with PublicId: {publicId}");
        }
    }

    private void EditFromViewModal()
    {
        if (selectedProduct != null)
        {
            showViewModal = false;
            EditProduct(selectedProduct.CloudPublicId);
        }
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        _editModel = new ProductsVm();
        EditErrorMessage = null;
        StateHasChanged();
    }

    // ============ UPDATE PRODUCT ============
    private async Task UpdateProduct()
    {
        try
        {
            isUpdating = true;
            EditErrorMessage = null;
            StateHasChanged();

            Console.WriteLine($"Updating product: {_editModel.ProductId}");

            var response = await ProductManager.UpdateProducts(_editModel);

            if (response.IsSuccess)
            {
                await LoadProductsAsync();
                CloseEditModal();
                Message = "Product updated successfully ✅";
                IsSuccessModalVisible = true;
            }
            else
            {
                EditErrorMessage = response.Message ?? "Update failed";
                Console.WriteLine($"Update failed: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            EditErrorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Update exception: {ex}");
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    // ============ DELETE PRODUCT ============
    private void DeleteProduct(string publicId, Guid productId)
    {
        Console.WriteLine($"DeleteProduct called - PublicId: {publicId}, ProductId: {productId}");
        selectedProduct = products.FirstOrDefault(p => p.ProductId == productId);
        if (selectedProduct != null)
        {
            showDeleteModal = true;
            StateHasChanged();
        }
    }

    private void DeleteFromViewModal()
    {
        if (selectedProduct != null)
        {
            showViewModal = false;
            showDeleteModal = true;
            StateHasChanged();
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task ConfirmDeleteProduct()
    {
        if (selectedProduct == null) return;
        try
        {
            isDeleting = true;
            StateHasChanged();
            var response = await ProductManager.RemoveProducts(selectedProduct.ProductId);
            if (response.IsSuccess)
            {
                await LoadProductsAsync();
                CloseDeleteModal();
                Message = "Product deleted successfully ✅";
                IsSuccessModalVisible = true;
            }
            else
            {
                ErrorMessage = response.Message ?? "Delete failed";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    public async Task RefreshProducts()
    {
        await LoadProductsAsync();
    }
}