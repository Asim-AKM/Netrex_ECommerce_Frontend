@page "/shipping-and-returns"

<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
   
<!-- BEGIN: HeroSection -->
<section class="hero-section bg-netrex-brand text-center" data-purpose="hero-banner">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">Shipping &amp; Returns</h1>
                <p>Everything you need to know about getting your Netrex orders and our hassle-free returns process.</p>
            </div>
        </div>
    </div>
</section>
<!-- END: HeroSection -->
<!-- BEGIN: MainContent -->
<main class="container policy-container py-5" data-purpose="policy-content">
    <div class="row g-5">
        <!-- BEGIN: ShippingPolicy -->
        <section class="col-lg-6" data-purpose="shipping-details" id="shipping-policy">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-box bg-netrex-light">
                    <svg class="text-netrex-brand" fill="none" height="32" stroke="currentColor" viewbox="0 0 24 24" width="32" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </div>
                <h2 class="text-netrex-darkest h3">Shipping Policy</h2>
            </div>
            <div class="prose-custom">
                <!-- Timelines -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-netrex-dark mb-3">Delivery Timelines</h3>
                    <p>We process all orders within 1-2 business days. Delivery estimates depend on your location:</p>
                    <ul class="text-secondary">
                        <li><strong>Standard Shipping:</strong> 3-5 business days</li>
                        <li><strong>Express Shipping:</strong> 1-2 business days</li>
                        <li><strong>International:</strong> 7-14 business days (depending on customs)</li>
                    </ul>
                </div>
                <!-- Costs -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-netrex-dark mb-3">Shipping Costs</h3>
                    <div class="bg-netrex-light border border-info border-opacity-10 p-3 rounded-3">
                        <p class="mb-0 fw-bold text-netrex-darkest">Free standard shipping on all orders over $75!</p>
                    </div>
                    <ul class="list-unstyled mt-3">
                        <li class="d-flex justify-content-between border-bottom pb-2">
                            <span>Orders under $75</span>
                            <span class="fw-bold">$5.99 Flat Rate</span>
                        </li>
                        <li class="d-flex justify-content-between border-bottom pb-2">
                            <span>Express Shipping</span>
                            <span class="fw-bold">$14.95</span>
                        </li>
                    </ul>
                </div>
                <!-- Tracking -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-netrex-dark mb-3">Order Tracking</h3>
                    <p>Once your order has shipped, you will receive an email confirmation with a tracking number. You can track your package directly through our website using the portal below.</p>
                    <div class="mt-3">
                        <div class="input-group">
                            <input aria-label="Tracking ID" class="form-control tracking-input" placeholder="Enter Tracking ID (e.g. NX-123456)" type="text" />
                            <button class="btn btn-netrex-solid px-4" type="button">Track</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- END: ShippingPolicy -->
        <!-- BEGIN: ReturnsPolicy -->
        <section class="col-lg-6" data-purpose="returns-details" id="returns-refunds">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-box bg-netrex-light">
                    <svg class="text-netrex-brand" fill="none" height="32" stroke="currentColor" viewbox="0 0 24 24" width="32" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </div>
                <h2 class="text-netrex-darkest h3">Returns &amp; Refunds</h2>
            </div>
            <div class="prose-custom">
                <!-- Guarantee -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-netrex-dark mb-3">Netrex Guarantee</h3>
                    <p>We stand by the quality of our products. If you are not 100% satisfied with your purchase, you can return your items within <strong>30 days</strong> of delivery for a full refund or exchange.</p>
                </div>
                <!-- Conditions -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-netrex-dark mb-3">Return Conditions</h3>
                    <p>To be eligible for a return, your item must meet the following criteria:</p>
                    <ul class="text-secondary">
                        <li>Item must be unused and in the same condition that you received it.</li>
                        <li>Item must be in its original packaging with all tags attached.</li>
                        <li>Proof of purchase (order number or receipt) is required.</li>
                        <li><em>Note:</em> Final sale items and gift cards are non-returnable.</li>
                    </ul>
                </div>
                <!-- Process -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-netrex-dark mb-3">The Process</h3>
                    <div class="d-grid gap-3">
                        <div class="d-flex gap-3">
                            <span class="step-number">1</span>
                            <p class="mb-0">Initiate your return via our <strong>Online Returns Portal</strong> using your email and order number.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <span class="step-number">2</span>
                            <p class="mb-0">Print the prepaid shipping label provided and securely pack your items.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <span class="step-number">3</span>
                            <p class="mb-0">Drop off the package at any authorized carrier location.</p>
                        </div>
                        <div class="d-flex gap-3">
                            <span class="step-number">4</span>
                            <p class="mb-0">Once received, we process your refund to the original payment method within 5-7 business days.</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a class="btn btn-netrex-outline rounded-3 w-100 w-md-auto" href="#">
                            Start a Return
                        </a>
                    </div>
                </div>
            </div>
        </section>
        <!-- END: ReturnsPolicy -->
    </div>
</main>
<!-- END: MainContent -->
<!-- BEGIN: SupportSection -->
<section class="support-section text-center" data-purpose="support-callout">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="h3 fw-bold text-netrex-darkest mb-3">Still have questions?</h2>
                <p class="text-muted mb-4">Our customer support team is available Monday through Friday, 9am - 6pm EST to assist with any shipping or return concerns.</p>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                    <a class="text-netrex-dark fw-bold text-decoration-none d-flex align-items-center justify-content-center gap-2" href="mailto:support@netrex.com">
                        <svg fill="currentColor" height="20" viewbox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                        </svg>
                        support@netrex.com
                    </a>
                    <a class="text-netrex-dark fw-bold text-decoration-none d-flex align-items-center justify-content-center gap-2" href="tel:+1800NETREX">
                        <svg fill="currentColor" height="20" viewbox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 004.587 4.587l.773-1.548a1 1 0 011.06-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                        </svg>
                        1-800-NETREX
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END: SupportSection -->
