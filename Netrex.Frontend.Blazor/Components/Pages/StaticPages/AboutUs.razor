@page "/about-us"
 
<!-- Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />

<!-- BEGIN: Hero Section -->
<section class="hero-banner" data-purpose="hero-banner">
    <div class="bg-circle-1"></div>
    <div class="bg-circle-2"></div>
    <div class="container text-center position-relative">
        <h1 class="display-3 fw-bold mb-4 text-light">Redefining Excellence</h1>
        <p class="lead mx-auto" style="max-width: 768px; color: #e0f2f1;">
            Welcome to Netrex. We bridge the gap between premium quality and accessible e-commerce, delivering curated excellence to your doorstep.
        </p>
    </div>
</section>
<!-- END: Hero Section -->
<!-- BEGIN: Our Journey Section -->
<section class="section-padding bg-white" data-purpose="our-journey">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img alt="Netrex Office" class="img-fluid rounded-4 shadow-lg w-100" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD-WwCBjNtXx9Yc4JeksQo03j76bzRE7_kxc0_sNPjejJaNLANwcQtTiG91pTwWPo3cqTimyukD8QRmejbx2HI0_oyuuOc-TQGxgY9BySJck7In6h6bh14sdwlicS2HFfhNbxvm7Tln1LaStgSujDulh73ksZ76SxmEWMXuaaQEXKAjlLjmFk9Wc3qW6V3Fz0qaTMJ4_waOniEyDO1KpgQQ3Ka7qSUd5vS52wGQgx5RL-LZqE-JQvLb2oENhEezAtDiaZn1RzhtWdM" style="height: 400px; object-fit: cover;" />
            </div>
            <div class="col-lg-6">
                <h2 class="h1 fw-bold text-netrex-primary mb-4">Our Journey</h2>
                <div class="text-secondary lh-lg">
                    <p class="mb-3">
                        Founded in 2025, Netrex began with a simple observation: the digital marketplace was saturated with products, but lacked a personal touch of curated quality. We started in a small home office with a vision to simplify the shopping experience.
                    </p>
                    <p class="mb-3">
                        What began as a passion project quickly evolved into a thriving community of over 50,000 satisfied customers. Our growth is fueled by a relentless pursuit of better products, faster shipping, and a commitment to transparency that remains at our core.
                    </p>
                    <p class="mb-0">
                        Today, Netrex stands as a beacon for those who value craftsmanship and efficiency in the modern digital age.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END: Our Journey Section -->
<!-- BEGIN: Core Values Section -->
<section class="section-padding bg-netrex-light" data-purpose="what-drives-us">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h1 fw-bold text-netrex-deep">What Drives Us</h2>
            <div class="divider"></div>
        </div>
        <div class="row g-4">
            <!-- Value: Quality -->
            <div class="col-md-4">
                <div class="card h-100 p-4 text-center hover-lift bg-white border-0">
                    <div class="icon-box">
                        <span class="material-symbols-outlined fs-2">verified</span>
                    </div>
                    <h3 class="h4 fw-bold text-netrex-deep mb-3">Uncompromising Quality</h3>
                    <p class="text-secondary small">Every product in our catalog undergoes rigorous testing. If we wouldn't use it ourselves, we won't sell it to you.</p>
                </div>
            </div>
            <!-- Value: Customer First -->
            <div class="col-md-4">
                <div class="card h-100 p-4 text-center hover-lift bg-white border-0">
                    <div class="icon-box">
                        <span class="material-symbols-outlined fs-2">sentiment_satisfied</span>
                    </div>
                    <h3 class="h4 fw-bold text-netrex-deep mb-3">Customer First</h3>
                    <p class="text-secondary small">Our success is measured by your satisfaction. We offer 24/7 support and a no-questions-asked return policy.</p>
                </div>
            </div>
            <!-- Value: Sustainability -->
            <div class="col-md-4">
                <div class="card h-100 p-4 text-center hover-lift bg-white border-0">
                    <div class="icon-box">
                        <span class="material-symbols-outlined fs-2">favorite</span>
                    </div>
                    <h3 class="h4 fw-bold text-netrex-deep mb-3">Sustainability</h3>
                    <p class="text-secondary small">We are committed to eco-friendly packaging and partnering with suppliers who prioritize the planet.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- END: Core Values Section -->
