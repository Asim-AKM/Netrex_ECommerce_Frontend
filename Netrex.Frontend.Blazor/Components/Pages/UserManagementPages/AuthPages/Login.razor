@page "/login"
@rendermode InteractiveServer

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Create your account and start selling smarter.</p>
        </div>
        <EditForm class="auth-right" OnValidSubmit="HandleLogin" FormName="SignIn" Model="_model">
            <DataAnnotationsValidator />
            <h2>Login</h2>
            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/email-icon.png" />
                </span>
                <InputText @bind-value="_model.Email" type="email" class="form-control" placeholder="Email" required />
            </div>
            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/Lock black.png" />
                </span>
                <InputText name="Password" id="password" type="password" @bind-value="_model.Password" class="form-control" placeholder="Password" required />
                <span class="toggle-password" onclick="togglePassword()">
                    <img id="eyeIcon" src="assets/user-management-assets/icons/monkey-password-hide.png" style="height:25px" />
                </span>
            </div>
            <button class="btn btn-primary w-100">Login</button>
            <div class="auth-footer mt-3">
                <div class="auth-footer-links">
                    Don't have an account? <a href="/register">Create</a>
                </div>
                <div class="auth-footer-links">
                    Forgot Password? <a href="/verifyemail">Reset</a>
                </div>
            </div>
        </EditForm>
    </div>
</div>