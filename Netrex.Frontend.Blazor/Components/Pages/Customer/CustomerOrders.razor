@page "/customer/orders"
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<div class="customer-card">
    <div class="customer-card-header">
        <h5 class="customer-card-title">My Orders</h5>
    </div>
    <div class="customer-card-body">
        <div class="customer-orders-list" id="spOrdersList">
            <div class="customer-order-card mb-3 p-3" data-order-id="12345">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6>Wireless Headphones</h6>
                        <p class="text-muted mb-1">Order #12345 • Placed on 15 May 2024</p>
                        <span class="customer-badge customer-badge-success">Delivered</span>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>$59.99</strong>
                    </div>
                </div>
            </div>
            <div class="customer-order-card mb-3 p-3" data-order-id="12346">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6>Smart Watch</h6>
                        <p class="text-muted mb-1">Order #12346 • Placed on 12 May 2024</p>
                        <span class="customer-badge customer-badge-warning">Shipped</span>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>$199.99</strong>
                    </div>
                </div>
            </div>
            <div class="customer-order-card p-3" data-order-id="12347">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6>Gaming Mouse</h6>
                        <p class="text-muted mb-1">Order #12347 • Placed on 10 May 2024</p>
                        <span class="customer-badge customer-badge-info">Processing</span>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>$45.00</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty orders message (hidden by default) -->
        <div class="text-center py-4 customer-empty-orders" style="display: none;">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <p>No orders found</p>
            <a href="/customer/dashboard" class="btn customer-btn-primary">Continue Shopping</a>
        </div>
    </div>
</div>