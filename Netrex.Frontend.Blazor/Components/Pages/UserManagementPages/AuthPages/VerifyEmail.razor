@page "/verifyemail"
@namespace Netrex.Frontend.Blazor.Components.Pages.UserManagementPages.AuthPages
@rendermode InteractiveServer

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Create an account to start shopping.</p>
        </div>
        <div class="auth-right">
            <h2>Forget Password</h2>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger py-2" style="font-size: 0.8rem;">@ErrorMessage</div>
            }

            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/email-icon.png" alt="email" />
                </span>
                <input @bind="Email" @bind:event="oninput" type="email" class="form-control" placeholder="Email" />
            </div>
            <button class="btn btn-primary w-100 py-2" @onclick="HandleRegister" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Send OTP</span>
                }
            </button>
        </div>
    </div>
</div>