@page "/reset-password/{Email}"
@namespace Netrex.Frontend.Blazor.Components.Pages.UserManagementPages.AuthPages
@rendermode InteractiveServer

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Secure your account with a strong password.</p>
        </div>

        <EditForm class="auth-right" OnValidSubmit="HandleReset" Model="_model">
            <DataAnnotationsValidator />

            <h2 class="mb-3">New Password</h2>

            <!-- New Password -->
            <div class="password-field">
                <img class="left-icon"
                     src="assets/user-management-assets/icons/Lock black.png" />

                <InputText type="@(showNewPass ? "text" : "password")"
                           class="form-control password-input"
                           placeholder="New Password"
                           @bind-Value="_model.NewPassword" />

                <i class="bi @(showNewPass ? "bi-eye-slash" : "bi-eye") right-icon"
                   @onclick="() => showNewPass = !showNewPass"></i>
            </div>

            <!-- ✅ Fixed Validation Space -->
            <div class="validation-space">
                <ValidationMessage For="@(() => _model.NewPassword)" />
            </div>

            <!-- Confirm Password -->
            <div class="password-field mt-2">
                <img class="left-icon"
                     src="assets/user-management-assets/icons/Lock black.png" />

                <InputText type="@(showConfirmPass ? "text" : "password")"
                           class="form-control password-input"
                           placeholder="Confirm Password"
                           @bind-Value="_model.ConfirmPassword" />

                <i class="bi @(showConfirmPass ? "bi-eye-slash" : "bi-eye") right-icon"
                   @onclick="() => showConfirmPass = !showConfirmPass"></i>
            </div>

            <!-- ✅ Fixed Validation Space -->
            <div class="validation-space mb-3">
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 py-2 mt-2"
                    disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Processing...</span>
                }
                else
                {
                    <span>Update Password</span>
                }
            </button>

            <div class="auth-footer mt-3 text-center">
                <a href="/login">Back to Login</a>
            </div>
        </EditForm>
    </div>
</div>

<style>
    /* INPUT FIELD */
    .password-field {
        position: relative;
        width: 100%;
    }

    .password-input {
        height: 48px;
        padding-left: 45px;
        padding-right: 45px;
        border-radius: 10px;
    }

    .left-icon {
        position: absolute;
        top: 50%;
        left: 14px;
        transform: translateY(-50%);
        width: 20px;
        pointer-events: none;
    }

    .right-icon {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6c757d;
        font-size: 18px;
    }

    .password-input:focus {
        box-shadow: none;
    }

    /* ✅ VALIDATION FIX (NO JUMPING) */
    .validation-space {
        min-height: 22px;
        font-size: 13px;
        font-weight: bold;
        color: #dc3545;
        margin-top: 4px;
    }
</style>
