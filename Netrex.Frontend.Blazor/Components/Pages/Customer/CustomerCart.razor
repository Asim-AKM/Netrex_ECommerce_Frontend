@page "/customer/cart"
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<div class="customer-card">
    <div class="customer-card-header">
        <h5 class="customer-card-title">Shopping Cart</h5>
    </div>

    <div class="customer-card-body">

        @if (IsLoading)
        {
            <p>Loading cart...</p>
        }
        else if (getcartItems == null || !getcartItems.Any())
        {
            <div class="text-center py-4 customer-empty-cart">
                <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                <p>Your cart is empty</p>
                <button class="btn customer-btn-primary">Continue Shopping</button>
            </div>
        }
        else
        {
            <div class="customer-cart-items">

                @foreach (var item in getcartItems)
                {
                    <div class="customer-order-card mb-3 p-3">
                        <div class="row align-items-center">

                            <div class="col-md-8">
                                <h6>@item.ProductName</h6>
                                <p class="text-muted mb-1">
                                    Quantity: @item.Quantity × $@item.Price
                                </p>
                            </div>

                            <div class="col-md-4 text-md-end">

                                <strong>$@(item.Quantity* item.Price)</strong>

                                <button class="btn customer-btn-outline btn-sm ms-2 customer-remove-item"
                                        @onclick="() => RemoveItem(item.CartItemId)">
                                    <i class="fas fa-trash"></i>
                                </button>

                            </div>

                        </div>
                    </div>
                }

            </div>
        }

        <div class="d-flex justify-content-between align-items-center mt-4">

            <h5 class="customer-total-amount">
                Total: $
                <span id="spCartTotal">
                    @(getcartItems.Sum(x => x.Price * x.Quantity))
                </span>
            </h5>

            <button class="btn customer-btn-primary" @onclick="CheckOut">
                Checkout
            </button>

        </div>

    </div>
</div>