@page "/SellerAndShopDetailsDashboard"
@using Netrex.Frontend.Application.Services.ProductManagement.Interfaces
@using Netrex.Frontend.Application.ViewModels.ProductManagement
@using Netrex.Frontend.Blazor.Components.Layout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@layout SellerMainLayout
@inject IProductManager ProductManager
@inject IJSRuntime JSRuntime
@inject ICloudnaryManager CloudnaryManager
@inherits AuthComponentBase
@attribute [Authorize(Roles = "Admin, Seller")]

<PageTitle>Seller Hub</PageTitle>

<!-- Main Content -->
<div class="main-wrapper">
    <div class="content-area">
        <!-- Dashboard Tab -->
        <div id="dashboard" class="tab-pane active">
            <div class="page-header">
                <h1>Dashboard Overview</h1>
                <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#profileModal">
