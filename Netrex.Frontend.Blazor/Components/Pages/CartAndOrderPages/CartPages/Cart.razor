@page "/cart"

<main class="container cart-container">
    <h1 class="cart-title">Shopping Cart</h1>

    <section class="cart-wrapper">

        <!-- Cart Items Section -->
        <section class="cart-items" aria-label="Shopping Cart Items">

            @if (getcartItems.Any())
            {
                @foreach (var item in getcartItems)
                {
                    <article class="cart-item" data-id="@item.CartItemId">
                        <img src="https://picsum.photos/id/1050/100/120" alt="@item.ProductName" width="100" height="120" />
                        <div class="item-info">
                            <h2>@item.ProductName</h2>
                            <p>@item.Description</p>
                        </div>
                        <div class="item-price">@($"Rs {item.Price:N0}")</div>
                        <div class="qty-box">
                            <button class="qty-decrease" aria-label="Decrease quantity" @onclick="() => DecreaseQuantity(item)" disabled="@(item.Quantity <= 1)">-</button>
                            <span class="qty">@item.Quantity</span>
                            <button class="qty-increase" aria-label="Increase quantity" @onclick="() => IncreaseQuantity(item)">+</button>
                        </div>
                        <div class="item-total">@($"Rs {item.Price*item.Quantity:N0}")</div>
                        <button class="remove" aria-label="Remove item" @onclick="() => RemoveItem(item)">Remove</button>
                    </article>
                }
            }
            else
            {
                <p>Your shopping cart is empty.</p>
            }

        </section>

        <!-- Order Summary Section -->
        <aside class="summary" aria-label="Order Summary">
            <h2>Order Summary</h2>

            <div class="summary-row">
                <span>Subtotal</span>
                <span id="cart-subtotal">@($"Rs {Subtotal:N0}")</span>
            </div>

            <div class="summary-row">
                <span>Shipping</span>
                <span id="cart-shipping">@($"Rs {Shipping:N0}")</span>
            </div>

            <div class="summary-row total">
                <span>Total</span>
                <span id="cart-total">@($"Rs {Total:N0}")</span>
            </div>

            <button class="checkout-btn" disabled="@(!getcartItems.Any())">Proceed to Checkout</button>
            <a href="/shop" class="continue-btn">Continue Shopping</a>
        </aside>

    </section>
</main>
