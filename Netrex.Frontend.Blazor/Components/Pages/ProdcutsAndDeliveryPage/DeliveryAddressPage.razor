@page "/DeliveryAddressPage"
@using Netrex.Frontend.Blazor.Components.Layout
@inject NavigationManager Navigation
@rendermode InteractiveServer
@layout MainLayout

<div class="delivery-page">
    <div class="delivery-container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <span>Home</span> &gt; <span>Checkout</span> &gt; <span>Delivery Address</span>
        </div>

        <div class="delivery-card">
            <div class="card-header">
                <h3>Add New Shipping Address</h3>
                <button id="close-btn" @onclick="GoBack" title="Close">✕</button>
            </div>

            <form id="address-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Full name</label>
                        <input type="text" placeholder="Enter your first and last name" />
                    </div>
                    <div class="form-group">
                        <label>Province</label>
                        <select>
                            <option disabled selected value="">Please choose your province</option>
                            <option>KPK</option>
                            <option>SINDH</option>
                            <option>BALOCESTAN</option>
                            <option>PUNJAB</option>
                            <option>AZAD KASHMIR</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" placeholder="Please enter your phone number" />
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        <select>
                            <option disabled selected value="">Please choose your city</option>
                            <option>LAHORE</option>
                            <option>PESHAWER</option>
                            <option>KARACHI</option>
                            <option>QUETTA</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Building / House No / Floor / Street</label>
                        <input type="text" placeholder="Please enter" />
                    </div>
                    <div class="form-group">
                        <label>Area</label>
                        <select>
                            <option disabled selected value="">Please choose your area</option>
                            <option>Downtown</option>
                            <option>Suburb</option>
                            <option>Uptown</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Colony / Suburb</label>
                        <input type="text" placeholder="Please enter" />
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" placeholder="For Example: House# 123, Street# 123, ABC Road" />
                    </div>
                    <div class="form-group full-width">
                        <label>Select a label for effective delivery:</label>

                        <div class="radio-group">
                            <input type="radio" id="office" name="address_type" value="office" checked />
                            <label for="office">
                                <i class="bi bi-building"></i>
                                OFFICE
                            </label>

                            <input type="radio" id="home" name="address_type" value="home" />
                            <label for="home">
                                <i class="bi bi-house-door"></i>
                                HOME
                            </label>
                        </div>
                    </div>

                </div>

                <hr />

                <div class="form-actions">
                    <NavLink id="cancel-btn" class="btn-cancel" @onclick="GoBack">CANCEL</NavLink>
                    <NavLink class="btn-save" @onclick="SaveAddress">SAVE ADDRESS</NavLink>
                </div>

            </form>

            <div class="card-footer-info">
                <i class="bi bi-shield-check"></i>
                Your address is safe & will only be used for delivery purposes
            </div>

        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/ProductlandingPage");
    }

    private void SaveAddress()
    {
        Navigation.NavigateTo("/PaymentMethodPage");
        // Save logic here
    }
}
