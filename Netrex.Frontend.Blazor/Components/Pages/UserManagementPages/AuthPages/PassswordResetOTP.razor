@page "/verifyotp/{Email}"
@namespace Netrex.Frontend.Blazor.Components.Pages.UserManagementPages.AuthPages
@rendermode InteractiveServer

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="card shadow-lg border-0 p-4" style="max-width: 450px; border-radius: 15px;">
        <div class="card-body text-center">
            <div class="mb-4">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-block p-3">
                    <img src="assets/user-management-assets/icons/Lock black.png" alt="OTP" style="width: 40px;" />
                </div>
            </div>

            <h2 class="fw-bold">Verify OTP</h2>
            <p class="text-muted">
                We've sent a 6-digit confirmation code to:<br />
                <span class="text-dark fw-bold">@Email</span>
            </p>

            <div class="mt-4">
                <div class="mb-3">
                    <input type="text" maxlength="6" @bind="OtpCode" @bind:event="oninput"
                           class="form-control form-control-lg text-center fw-bold"
                           placeholder="· · · · · ·"
                           style="letter-spacing: 15px; font-size: 2rem; border: 2px solid #eee;" />
                </div>

                <button class="btn btn-primary w-100 py-3 fw-bold mt-2"
                        @onclick="VerifyOtp"
                        disabled="@(IsProcessing || OtpCode?.Length < 6)"
                        style="border-radius: 10px;">
                    @if (IsProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Verifying...</span>
                    }
                    else
                    {
                        <span>Verify Account</span>
                    }
                </button>
            </div>

            <div class="mt-4 pt-2 border-top">
                <p class="mb-1 text-muted small">Didn't receive the code?</p>
                <button class="btn btn-link text-decoration-none fw-bold p-0"
                        @onclick="ResendOtp"
                        disabled="@IsResendDisabled">
                    @(IsResendDisabled ? $"Resend in {ResendTimer}s" : "Resend New Code")
                </button>
            </div>
        </div>
    </div>
</div>