@page "/customer/wallet"
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<div class="customer-card">
    <div class="customer-card-header">
        <h5 class="customer-card-title">My Wallet</h5>
    </div>
    <div class="customer-card-body">
        <!-- Balance Card -->
        <div class="customer-wallet-balance-card mb-4 p-4 text-center">
            <div class="customer-wallet-balance-label text-muted mb-2">Available Balance</div>
            <div class="customer-wallet-balance-amount d-flex align-items-center justify-content-center">
                <h2 class="display-4 fw-bold mb-0" id="spWalletBalance" style="filter: none;">$1,250.50</h2>
                <button class="btn btn-link ms-2 p-0" onclick="toggleBalance()">
                    <i class="fas fa-eye" id="spBalanceEyeIcon"></i>
                </button>
            </div>
            <small class="text-muted" id="spBalanceHiddenMessage" style="display: none;">Balance hidden</small>
        </div>

        <!-- Withdrawal Button -->
        <div class="text-center mb-4">
            <button class="btn customer-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#spWithdrawModal">
                <i class="fas fa-arrow-up me-2"></i>Withdraw Funds
            </button>
        </div>

        <!-- Recent Transactions -->
        <h6 class="mb-3">Recent Transactions</h6>
        <div class="customer-wallet-transactions" id="spTransactionsList">
            <div class="customer-order-card mb-2 p-3" data-transaction-id="1">
                <div class="row align-items-center">
                    <div class="col-8">
                        <p class="mb-0 fw-semibold">Added Funds</p>
                        <small class="text-muted">Today, 10:30 AM</small>
                    </div>
                    <div class="col-4 text-end text-success">
                        <strong>+$500.00</strong>
                    </div>
                </div>
            </div>
            <div class="customer-order-card mb-2 p-3" data-transaction-id="2">
                <div class="row align-items-center">
                    <div class="col-8">
                        <p class="mb-0 fw-semibold">Withdrawal</p>
                        <small class="text-muted">Yesterday, 2:15 PM</small>
                    </div>
                    <div class="col-4 text-end text-danger">
                        <strong>-$50.00</strong>
                    </div>
                </div>
            </div>
            <div class="customer-order-card p-3" data-transaction-id="3">
                <div class="row align-items-center">
                    <div class="col-8">
                        <p class="mb-0 fw-semibold">Cashback</p>
                        <small class="text-muted">12 May 2024</small>
                    </div>
                    <div class="col-4 text-end text-success">
                        <strong>+$10.50</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty transactions message (hidden by default) -->
        <div class="text-center py-4 customer-empty-transactions" style="display: none;">
            <i class="fas fa-history fa-3x text-muted mb-3"></i>
            <p>No transactions yet</p>
        </div>
    </div>
</div>

<!-- Withdrawal Modal -->
<div class="modal fade" id="spWithdrawModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content customer-modal-content">
            <div class="modal-header customer-modal-header">
                <h5 class="modal-title">Withdraw Funds</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body customer-modal-body">
                <div class="mb-3">
                    <label class="customer-form-label">Amount ($)</label>
                    <input type="number" class="form-control customer-form-control" id="spWithdrawAmount" placeholder="Enter amount" min="1" step="0.01">
                </div>
                <div class="mb-3">
                    <label class="customer-form-label">Withdrawal Method</label>
                    <select class="form-select customer-form-control" id="spWithdrawMethod">
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="PayPal">PayPal</option>
                        <option value="JazzCash">JazzCash</option>
                    </select>
                </div>
                <div class="alert alert-info small">
                    <i class="fas fa-info-circle me-2"></i>
                    Minimum withdrawal: $10.00
                </div>
            </div>
            <div class="modal-footer customer-modal-footer">
                <button type="button" class="btn customer-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn customer-btn-primary" onclick="withdrawConfirm()">Withdraw</button>
            </div>
        </div>
    </div>
</div>

