@inherits LayoutComponentBase

<div class="empty-layout">
    <style>
        /* Isolated styles for EmptyLayout - FULL SCREEN */
        .empty-layout {
            all: initial !important;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            min-width: 100vw !important;
            min-height: 100vh !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            overflow: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
            z-index: 9999 !important;
            /* Perfect Teal-White Water Ink Mix - FULL SCREEN */
            background: linear-gradient(135deg, rgba(3, 173, 174, 0.95) 0%, rgba(255, 255, 255, 0.4) 30%, rgba(3, 173, 174, 0.85) 60%, rgba(255, 255, 255, 0.3) 90%, rgba(3, 173, 174, 0.9) 100% ) !important;
            /* Water Ink Drops - FULL SCREEN */
            background-image:
            /* Large white ink center */
            radial-gradient( circle at 50% 50%, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.4) 25%, rgba(3, 173, 174, 0.6) 45%, transparent 75% ) !important,
            /* Teal ink top-left */
            radial-gradient( circle at 25% 25%, rgba(3, 173, 174, 0.9) 0%, rgba(3, 173, 174, 0.5) 20%, rgba(255, 255, 255, 0.3) 40%, transparent 70% ) !important,
            /* White ink bottom-right */
            radial-gradient( circle at 75% 75%, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.3) 22%, rgba(3, 173, 174, 0.5) 42%, transparent 72% ) !important,
            /* Teal ink middle-right */
            radial-gradient( circle at 80% 50%, rgba(3, 173, 174, 0.8) 0%, rgba(3, 173, 174, 0.4) 18%, rgba(255, 255, 255, 0.2) 38%, transparent 68% ) !important,
            /* White ink middle-left */
            radial-gradient( circle at 20% 50%, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.2) 24%, rgba(3, 173, 174, 0.4) 44%, transparent 74% ) !important;
            /* Background sizes for FULL SCREEN */
            background-size: 100% 100%, 80% 80%, 90% 90%, 70% 70%, 60% 60% !important;
            background-position: 50% 50%, 25% 25%, 75% 75%, 80% 50%, 20% 50% !important;
            background-repeat: no-repeat !important;
            background-blend-mode: overlay, multiply, overlay, multiply, overlay !important;
            animation: waterInkFlow 20s infinite alternate ease-in-out !important;
        }

        /* Water Ink Flow Animation - FULL SCREEN */
        @@keyframes waterInkFlow {
            0% {
                background-position: 50% 50%, 25% 25%, 75% 75%, 80% 50%, 20% 50%;
                background-size: 100% 100%, 80% 80%, 90% 90%, 70% 70%, 60% 60%;
            }

            50% {
                background-position: 55% 45%, 30% 20%, 70% 80%, 85% 55%, 15% 45%;
                background-size: 105% 105%, 85% 85%, 95% 95%, 75% 75%, 65% 65%;
            }

            100% {
                background-position: 45% 55%, 20% 30%, 80% 70%, 75% 45%, 25% 55%;
                background-size: 95% 95%, 75% 75%, 85% 85%, 65% 65%, 55% 55%;
            }
        }

        /* Ink Overlay - FULL SCREEN */
        .ink-overlay {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            min-width: 100vw !important;
            min-height: 100vh !important;
            background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.2) 0%, transparent 50%), radial-gradient(circle at 60% 60%, rgba(3, 173, 174, 0.2) 0%, transparent 50%) !important;
            backdrop-filter: blur(20px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
            mix-blend-mode: soft-light !important;
            opacity: 0.5 !important;
            pointer-events: none !important;
            z-index: 1 !important;
        }

        /* Content Wrapper - FULL SCREEN */
        .content-wrapper {
            position: relative !important;
            z-index: 20 !important;
            width: 100% !important;
            height: 100% !important;
            min-width: 100vw !important;
            min-height: 100vh !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            background: transparent !important;
        }

        /* Global Styles for FULL SCREEN */
        html, body {
            width: 100% !important;
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
        }

        /* Make sure ALL parent elements are full screen */
        #app, #root, .app, .root {
            width: 100% !important;
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* Responsive - FULL SCREEN */
        @@media (max-width: 768px) {
            .empty-layout {
                background-size: 120% 120%, 100% 100%, 110% 110%, 90% 90%, 80% 80% !important;
                animation-duration: 30s !important;
            }

            .ink-overlay {
                backdrop-filter: blur(15px) saturate(160%) !important;
                -webkit-backdrop-filter: blur(15px) saturate(160%) !important;
            }
        }
    </style>

    <div class="ink-overlay"></div>
    <div class="content-wrapper">
        @Body
    </div>
</div>