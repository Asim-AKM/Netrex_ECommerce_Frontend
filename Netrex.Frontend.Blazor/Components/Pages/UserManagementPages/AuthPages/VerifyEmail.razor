@page "/verifyemail"
@namespace Netrex.Frontend.Blazor.Components.Pages.UserManagementPages.AuthPages
@rendermode InteractiveServer

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Create an account to start shopping.</p>
        </div>

        <EditForm class="auth-right" Model="Model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <h2>Forget Password</h2>
            <div class="input-group mb-1">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/email-icon.png" alt="email" />
                </span>
                <InputText type="email"
                           class="form-control"
                           placeholder="Email"
                           @bind-Value="Model.Email" />
            </div>
            <!-- ✅ Validation Error (No CSS Added) -->
            <ValidationMessage For="@(() => Model.Email)"
                               class="text-danger small fw-bold mb-2 d-block" />

            <button class="btn btn-primary w-100 py-2"
                    type="submit"
                    disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Send OTP</span>
                }
            </button>
        </EditForm>
    </div>
</div>
