@page "/verifyemail"
@namespace Netrex.Frontend.Blazor.Components.Pages.UserManagementPages.AuthPages
@rendermode InteractiveServer

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-right">
            <h2>Forget Password</h2>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }

            <input @bind="Email" @bind:event="oninput" type="email" class="form-control" placeholder="Email" />

            <button class="btn btn-primary w-100 mt-3" @onclick="VerifyAndRedirect" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Send OTP</span>
                }
            </button>
        </div>
    </div>
</div>