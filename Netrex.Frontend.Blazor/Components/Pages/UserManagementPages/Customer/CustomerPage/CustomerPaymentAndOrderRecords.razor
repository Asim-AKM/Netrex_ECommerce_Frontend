
@page "/customer-payments-records"
@rendermode InteractiveServer
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<!-- CONTENT FOR USER DASHBOARD -->
<div class="payment-content-wrapper">
    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary-custom mb-0"><i class="bi bi-credit-card-2-front"></i> My Payments & Orders</h2>
            <p class="text-muted mb-0">Track your payments, invoices, and refund requests</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <h3>12</h3>
                <p>Total Orders</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card success">
                <h3>$2,450.00</h3>
                <p>Total Spent</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card info">
                <h3>10</h3>
                <p>Completed Payments</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card warning">
                <h3>2</h3>
                <p>Pending/Refund</p>
            </div>
        </div>
    </div>

    <!-- Tabs for different sections -->
    <ul class="nav nav-tabs-custom mb-3" id="paymentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button @onclick="() => SetTab(ActiveTabType.Payment)" class="nav-link @(ActiveTab == ActiveTabType.Payment ? "active" : "")" id="payments-tab" type="button">
                <i class="bi bi-credit-card"></i> My Payments
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button @onclick="() => SetTab(ActiveTabType.Invoice)" class="nav-link @(ActiveTab == ActiveTabType.Invoice ? "active" : "")" id="invoices-tab" type="button">
                <i class="bi bi-receipt"></i> Invoices
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button @onclick="() => SetTab(ActiveTabType.Refund)" class="nav-link @(ActiveTab == ActiveTabType.Refund ? "active" : "")" id="refunds-tab" type="button">
                <i class="bi bi-arrow-counterclockwise"></i> Refunds & Disputes
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="paymentTabsContent">
        @if (ActiveTab == ActiveTabType.Payment)
        {
            <!-- Payments Tab -->
            <div class="tab-pane fade show active" id="payments" role="tabpanel">
                <!-- Search and Filter -->
                <div class="search-filter-section">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <input type="text" class="form-control form-control-custom" placeholder="Search by Order ID or Transaction ID">
                        </div>
                        <div class="col-md-3 mb-3">
                            <select class="form-select form-select-custom">
                                <option value="">Payment Status</option>
                                <option value="successful">Successful</option>
                                <option value="pending">Pending</option>
                                <option value="failed">Failed</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <input type="date" class="form-control form-control-custom">
                        </div>
                        <div class="col-md-2 mb-3">
                            <button class="btn btn-primary-custom w-100"><i class="bi bi-search"></i> Search</button>
                        </div>
                    </div>
                </div>

                <!-- Payment History Table -->
                <div class="custom-card">
                    <div class="card-header-custom">
                        <i class="bi bi-clock-history"></i> Payment History
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Date</th>
                                    <th>Payment Method</th>
                                    <th>Transaction ID</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>#ORD-1234</strong></td>
                                    <td>2026-01-15 10:30 AM</td>
                                    <td><i class="bi bi-credit-card payment-method-icon"></i> Visa Card</td>
                                    <td>TXN-ABC123</td>
                                    <td>$450.00</td>
                                    <td><span class="badge-success-custom"><i class="bi bi-check-circle"></i> Successful</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-info-custom" title="View Details"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm-custom btn-secondary-custom" title="Download Invoice"><i class="bi bi-download"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>#ORD-1235</strong></td>
                                    <td>2026-01-16 02:15 PM</td>
                                    <td><i class="bi bi-wallet2 payment-method-icon"></i> Easypaisa</td>
                                    <td>TXN-XYZ456</td>
                                    <td>$320.50</td>
                                    <td><span class="badge-success-custom"><i class="bi bi-check-circle"></i> Successful</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-info-custom" title="View Details"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm-custom btn-secondary-custom" title="Download Invoice"><i class="bi bi-download"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>#ORD-1236</strong></td>
                                    <td>2026-01-17 11:45 AM</td>
                                    <td><i class="bi bi-cash-coin payment-method-icon"></i> Cash on Delivery</td>
                                    <td>TXN-DEF789</td>
                                    <td>$875.00</td>
                                    <td><span class="badge-warning-custom"><i class="bi bi-hourglass-split"></i> Pending</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-info-custom" title="View Details"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>#ORD-1237</strong></td>
                                    <td>2026-01-18 09:00 AM</td>
                                    <td><i class="bi bi-phone payment-method-icon"></i> JazzCash</td>
                                    <td>TXN-GHI012</td>
                                    <td>$225.00</td>
                                    <td><span class="badge-danger-custom"><i class="bi bi-x-circle"></i> Failed</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-info-custom" title="View Details"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm-custom btn-warning-custom" title="Retry Payment"><i class="bi bi-arrow-repeat"></i> Retry</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == ActiveTabType.Invoice)
        {
            <!-- Invoices Tab -->
            <div class="tab-pane fade show active" id="invoices" role="tabpanel">
                <div class="custom-card">
                    <div class="card-header-custom">
                        <i class="bi bi-file-earmark-text"></i> My Invoices
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Order ID</th>
                                    <th>Date</th>
                                    <th>Total Amount</th>
                                    <th>Payment Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>#INV-001</strong></td>
                                    <td>#ORD-1234</td>
                                    <td>2026-01-15</td>
                                    <td>$450.00</td>
                                    <td><span class="badge-success-custom">Paid</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-primary-custom"><i class="bi bi-download"></i> Download PDF</button>
                                        <button class="btn btn-sm-custom btn-secondary-custom"><i class="bi bi-printer"></i> Print</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>#INV-002</strong></td>
                                    <td>#ORD-1235</td>
                                    <td>2026-01-16</td>
                                    <td>$320.50</td>
                                    <td><span class="badge-success-custom">Paid</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-primary-custom"><i class="bi bi-download"></i> Download PDF</button>
                                        <button class="btn btn-sm-custom btn-secondary-custom"><i class="bi bi-printer"></i> Print</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>#INV-003</strong></td>
                                    <td>#ORD-1236</td>
                                    <td>2026-01-17</td>
                                    <td>$875.00</td>
                                    <td><span class="badge-warning-custom">Pending</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-warning-custom"><i class="bi bi-credit-card"></i> Pay Now</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Refunds & Disputes Tab -->
            <div class="tab-pane fade show active" id="refunds" role="tabpanel">
                <!-- Request Refund Section -->
                <div class="custom-card">
                    <div class="card-header-custom">
                        <i class="bi bi-plus-circle"></i> Request Refund
                    </div>
                    <form>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">Select Order</label>
                                <select class="form-select form-select-custom" required>
                                    <option value="">Choose an order...</option>
                                    <option value="ORD-1234">#ORD-1234 - $450.00 (Delivered)</option>
                                    <option value="ORD-1235">#ORD-1235 - $320.50 (Delivered)</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">Refund Reason</label>
                                <select class="form-select form-select-custom" required>
                                    <option value="">Select reason...</option>
                                    <option value="damaged">Product Damaged</option>
                                    <option value="wrong">Wrong Item Received</option>
                                    <option value="quality">Quality Issues</option>
                                    <option value="notreceived">Item Not Received</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label-custom">Description</label>
                                <textarea class="form-control form-control-custom" rows="3" placeholder="Explain your issue in detail..." required></textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary-custom"><i class="bi bi-send"></i> Submit Refund Request</button>
                    </form>
                </div>

                <!-- Refund Requests Table -->
                <div class="custom-card">
                    <div class="card-header-custom">
                        <i class="bi bi-list-ul"></i> My Refund Requests
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>Request ID</th>
                                    <th>Order ID</th>
                                    <th>Requested Date</th>
                                    <th>Reason</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>#REF-001</strong></td>
                                    <td>#ORD-1230</td>
                                    <td>2026-01-10</td>
                                    <td>Product Damaged</td>
                                    <td>$150.00</td>
                                    <td><span class="badge-success-custom">Approved</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-info-custom"><i class="bi bi-eye"></i> View</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>#REF-002</strong></td>
                                    <td>#ORD-1225</td>
                                    <td>2026-01-12</td>
                                    <td>Wrong Item</td>
                                    <td>$75.00</td>
                                    <td><span class="badge-warning-custom">Processing</span></td>
                                    <td>
                                        <button class="btn btn-sm-custom btn-info-custom"><i class="bi bi-eye"></i> View</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ActiveTabType ActiveTab = ActiveTabType.Payment;

    private void SetTab(ActiveTabType tab)
    {
        ActiveTab = tab;
        StateHasChanged();  // Force re-render to update the UI
    }

    private enum ActiveTabType
    {
        Payment,
        Invoice,
        Refund
    }
}
