                </div>
                <div class="stat-card">
                    <div class="stat-label">Active Products</div>
                    <div class="stat-value" id="activeProductsCount">@products.Count</div>
                    <div class="stat-change">In stock</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Average Rating</div>
                    <div class="stat-value">4.8 ⭐</div>
                    <div class="stat-change">From 342 reviews</div>
                </div>
            </div>
