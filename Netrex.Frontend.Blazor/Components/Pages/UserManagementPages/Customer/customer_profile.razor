@page "/Customer_profile"
@using System.Net.Http.Json
@inject HttpClient Http

<div class="profile-card">

    <!-- Header -->
    <div class="profile-header">
        <div class="profile-pic-wrapper">
            <img src="@PreviewImage" class="profile-pic" />
            <label class="camera-icon">
                📷
                <InputFile OnChange="OnImageChange" hidden />
            </label>
        </div>
        <h4>Customer Profile</h4>
    </div>

    <!-- Body -->
    <div class="profile-body">
        <EditForm Model="customer" OnValidSubmit="SaveCustomer">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">City</label>
                <InputText class="form-control" @bind-Value="customer.City" />
            </div>

            <div class="mb-3">
                <label class="form-label">Province</label>
                <InputText class="form-control" @bind-Value="customer.Province" />
            </div>

            <div class="mb-3">
                <label class="form-label">Country</label>
                <InputText class="form-control" @bind-Value="customer.Country" />
            </div>

            <div class="mb-4">
                <label class="form-label">Address</label>
                <InputTextArea class="form-control" rows="3"
                               @bind-Value="customer.Address" />
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Save Profile
            </button>
        </EditForm>
    </div>
</div>


<div class="orders-card mt-5">

    <h4 class="section-title">Customer Orders</h4>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Order No</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderNo</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>Rs. @order.TotalAmount</td>
                        <td>
                            <span class="badge @GetStatusClass(order.Status)">
                                @order.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="summary-box">
        Total Orders: @Orders.Count
    </div>
</div>















<div class="footer">
    Built by Muhammad Ashar
</div>

@code {

    private string PreviewImage = "images/default-avatar.png";

    private CustomerDto customer = new();

    // DTO
    public class CustomerDto
    {
        public string City { get; set; }
        public string Province { get; set; }
        public string Country { get; set; }
        public string Address { get; set; }
    }

    // Save (POST / PUT)
    private async Task SaveCustomer()
    {
        await Http.PostAsJsonAsync("api/customers", customer);
    }

    // Image Preview
    private async Task OnImageChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var buffer = new byte[file.Size];
        await file.OpenReadStream().ReadAsync(buffer);

        PreviewImage = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

 List<OrderDto> Orders = new()
    {
        new OrderDto { Id = 1, OrderNo = "ORD-1001", OrderDate = DateTime.Now.AddDays(-5), TotalAmount = 1500, Status = "Completed" },
        new OrderDto { Id = 2, OrderNo = "ORD-1002", OrderDate = DateTime.Now.AddDays(-2), TotalAmount = 2200, Status = "Pending" },
        new OrderDto { Id = 3, OrderNo = "ORD-1003", OrderDate = DateTime.Now.AddDays(-1), TotalAmount = 800, Status = "Cancelled" }
    };

    public class OrderDto
    {
        public int Id { get; set; }
        public string OrderNo { get; set; }
        public DateTime OrderDate { get; set; }
        public decimal TotalAmount { get; set; }
        public string Status { get; set; }
    }

    string GetStatusClass(string status) => status switch
    {
        "Completed" => "badge-completed",
        "Pending" => "badge-pending",
        "Cancelled" => "badge-cancelled",
        _ => "bg-secondary"
    };
}