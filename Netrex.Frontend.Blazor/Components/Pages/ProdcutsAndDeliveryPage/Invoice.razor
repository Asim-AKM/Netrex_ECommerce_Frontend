@page "/invoice"
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="invoice-page">

    <div class="invoice-card">
        <div class="card-header">
            <span>Invoice #12345</span>
            <span>Netrex E-Commerce</span>
        </div>

        <div class="alert-success-box mt-3">
            <i class="bi bi-check-circle"></i>
            Order Confirmed Successfully!
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h6 class="text-muted mb-3">Customer Information:</h6>
                    <p class="mb-1 fw-bold">John Doe</p>
                    <p class="mb-1 text-muted">john.doe@example.com</p>
                    <p class="text-muted">+1 (555) 123-4567</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h6 class="text-muted mb-3">Delivery Address:</h6>
                    <p class="mb-1">123 Main Street, Apt 4B</p>
                    <p class="mb-1">New York, NY 10001</p>
                    <p class="badge bg-light text-dark border-light">Standard Shipping</p>
                </div>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Item Description</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Premium Wireless Headphones</td>
                            <td class="text-center">1</td>
                            <td class="text-end">$299.99</td>
                            <td class="text-end fw-bold">$299.99</td>
                        </tr>
                        <tr>
                            <td>Bluetooth Speaker</td>
                            <td class="text-center">2</td>
                            <td class="text-end">$74.99</td>
                            <td class="text-end fw-bold">$149.98</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end mt-4">
                <div class="col-md-5 col-lg-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>$449.97</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax</span>
                        <span>$37.50</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between total-row">
                        <span>Total Amount</span>
                        <span class="text-primary">$497.47</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer d-print-none">
            <div class="d-flex flex-wrap gap-2 justify-content-between">
                <button class="btn btn-outline-dark" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i>Print Invoice
                </button>
                <div class="d-flex gap-2">
                    <button class="btn btn-light">Home</button>
                    <button class="btn btn-primary">Track Order <i class="bi bi-truck ms-1"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>
