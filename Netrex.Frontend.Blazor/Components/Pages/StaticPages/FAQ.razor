@page "/faq"
   
<!-- BEGIN: HeroSection -->
<section class="hero-section">
    <div class="container">
        <h1 class="hero-title">How can we help you?</h1>
        <p class="hero-subtitle text-dark-emphasis">Find answers to the most common questions about shopping at Netrex. If you can't find what you're looking for, please contact our support team.</p>
    </div>
</section>
<!-- END: HeroSection -->
<!-- BEGIN: FAQAccordion -->
<main class="container">
    <div class="faq-container">
        <!-- Shipping Category -->
        <div class="category-section">
            <h2 class="category-title">
                <i class="fa-solid fa-truck-fast category-icon"></i> Shipping &amp; Delivery
            </h2>
            <div class="accordion" id="shippingAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingOne">
                        <button aria-controls="collapseOne" aria-expanded="true" class="accordion-button" data-bs-target="#collapseOne" data-bs-toggle="collapse" type="button">
                            What are your shipping rates and delivery times?
                        </button>
                    </h2>
                    <div aria-labelledby="headingOne" class="accordion-collapse collapse show" data-bs-parent="#shippingAccordion" id="collapseOne">
                        <div class="accordion-body">
                            We offer free standard shipping on all orders over $50. For orders under $50, a flat rate of $5.99 applies. Standard delivery typically takes 3-5 business days. Expedited shipping is available at checkout for an additional fee.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingTwo">
                        <button aria-controls="collapseTwo" aria-expanded="false" class="accordion-button collapsed" data-bs-target="#collapseTwo" data-bs-toggle="collapse" type="button">
                            Do you ship internationally?
                        </button>
                    </h2>
                    <div aria-labelledby="headingTwo" class="accordion-collapse collapse" data-bs-parent="#shippingAccordion" id="collapseTwo">
                        <div class="accordion-body">
                            Yes, Netrex ships to over 50 countries worldwide. International shipping rates vary by destination and will be calculated at checkout. Please note that customs duties may apply depending on your local regulations.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Products Category -->
        <div class="category-section">
            <h2 class="category-title">
                <i class="fa-solid fa-box-open category-icon"></i> Products &amp; Stock
            </h2>
            <div class="accordion" id="productsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingProdOne">
                        <button aria-controls="collapseProdOne" aria-expanded="false" class="accordion-button collapsed" data-bs-target="#collapseProdOne" data-bs-toggle="collapse" type="button">
                            Are your products authentic?
                        </button>
                    </h2>
                    <div aria-labelledby="headingProdOne" class="accordion-collapse collapse" data-bs-parent="#productsAccordion" id="collapseProdOne">
                        <div class="accordion-body">
                            Absolutely. Netrex partners directly with authorized distributors and manufacturers to ensure that every product on our site is 100% authentic and premium quality.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingProdTwo">
                        <button aria-controls="collapseProdTwo" aria-expanded="false" class="accordion-button collapsed" data-bs-target="#collapseProdTwo" data-bs-toggle="collapse" type="button">
                            How do I know if an item is back in stock?
                        </button>
                    </h2>
                    <div aria-labelledby="headingProdTwo" class="accordion-collapse collapse" data-bs-parent="#productsAccordion" id="collapseProdTwo">
                        <div class="accordion-body">
                            On the product page of an out-of-stock item, you can click the "Notify Me" button. Enter your email address, and we'll send you an automatic alert as soon as the item is available for purchase again.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Returns Category -->
        <div class="category-section">
            <h2 class="category-title">
                <i class="fa-solid fa-rotate-left category-icon"></i> Returns &amp; Exchanges
            </h2>
            <div class="accordion" id="returnsAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingRetOne">
                        <button aria-controls="collapseRetOne" aria-expanded="false" class="accordion-button collapsed" data-bs-target="#collapseRetOne" data-bs-toggle="collapse" type="button">
                            What is your return policy?
                        </button>
                    </h2>
                    <div aria-labelledby="headingRetOne" class="accordion-collapse collapse" data-bs-parent="#returnsAccordion" id="collapseRetOne">
                        <div class="accordion-body">
                            We offer a 30-day hassle-free return policy. If you're not satisfied with your purchase, you can return it in its original condition and packaging for a full refund. Some exclusions apply for hygiene-related products.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingRetTwo">
                        <button aria-controls="collapseRetTwo" aria-expanded="false" class="accordion-button collapsed" data-bs-target="#collapseRetTwo" data-bs-toggle="collapse" type="button">
                            How long does a refund take to process?
                        </button>
                    </h2>
                    <div aria-labelledby="headingRetTwo" class="accordion-collapse collapse" data-bs-parent="#returnsAccordion" id="collapseRetTwo">
                        <div class="accordion-body">
                            Once we receive your returned item and inspect it, your refund will be processed within 5-7 business days. The funds will be credited back to your original payment method.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<!-- END: FAQAccordion -->
