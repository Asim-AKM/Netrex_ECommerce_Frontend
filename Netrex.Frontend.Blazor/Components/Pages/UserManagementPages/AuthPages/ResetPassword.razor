@page "/reset-password/{Email}"
@namespace Netrex.Frontend.Blazor.Components.Pages.UserManagementPages.AuthPages

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Secure your account with a strong password.</p>
        </div>
        <div class="auth-right">
            <h2>New Password</h2>
            <p class="small text-muted">Set a new password for your account.</p>

            @* New Password Field *@
            <div class="mb-3">
                <div class="input-group">
                    <span class="icon">
                        <img src="assets/user-management-assets/icons/Lock black.png" />
                    </span>
                    <input type="@passwordType" @bind="NewPassword" @bind:event="oninput"
                           class="form-control @(ActiveErrorField == "password" ? "is-invalid" : "")" placeholder="New Password" />
                    <span class="toggle-password" style="cursor:pointer; padding: 5px;" @onclick="TogglePassword">
                        <img src="@eyeIcon" style="height:20px" />
                    </span>
                </div>
                @if (ActiveErrorField == "password")
                {
                    <small class="text-danger">@ErrorMessage</small>
                }
            </div>

            @* Confirm Password Field *@
            <div class="mb-3">
                <div class="input-group">
                    <span class="icon">
                        <img src="assets/user-management-assets/icons/Lock black.png" />
                    </span>
                    <input type="password" @bind="ConfirmPassword" @bind:event="oninput"
                           class="form-control @(ActiveErrorField == "confirm" ? "is-invalid" : "")" placeholder="Confirm Password" />
                </div>
                @if (ActiveErrorField == "confirm")
                {
                    <small class="text-danger">@ErrorMessage</small>
                }
            </div>

            @if (IsSuccess)
            {
                <div class="alert alert-success py-2 shadow-sm">✅ Password Reset Successfully!</div>
            }

            <button class="btn btn-primary w-100 py-2 mt-2" @onclick="HandleReset" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Update Password</span>
                }
            </button>
        </div>
    </div>
</div>