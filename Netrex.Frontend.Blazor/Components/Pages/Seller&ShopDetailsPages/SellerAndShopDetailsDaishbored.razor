        <!-- ============ PRODUCTS TAB ============ -->
        <div id="products" class="tab-pane">
            <div class="page-header">
                <h1>Product Management</h1>
                <button class="btn-primary" @onclick="ShowModal">
                    <i class="fas fa-plus"></i> Add Product
                </button>
            </div>

            <!-- Product Gallery -->
            <div class="product-grid" id="productGrid">
                @if (isLoadingProducts)
                {
                    <div style="text-align: center; padding: 40px; width: 100%;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p style="margin-top: 10px;">Loading products...</p>
                    </div>
                }
                else if (products == null || products.Count == 0)
                {
                    <div class="no-products" style="text-align: center; padding: 40px; width: 100%;">
                        <p>No products found</p>
                        <button class="btn btn-primary" @onclick="ShowModal">
                            Add Your First Product
                        </button>
                    </div>
                }
                else
                {
                    @foreach (var product in products)
                    {
                        <div class="product-card">
                            <div class="product-image">
                                <img src="@(product.ImageUrl ?? "/assets/placeholder.jpg")"
                                     alt="@product.ProductName"
                                     onerror="this.src='/assets/placeholder.jpg'">
                            </div>
                            <div class="product-info">
                                <div class="product-name">@product.ProductName</div>
                                <div class="product-sku">Description: @(product.ProductDescription ?? "N/A")</div>
                                <div class="product-price-row">
                                    @if (product.Discount > 0)
                                    {
                                        <div class="product-price">
                                            <span style="text-decoration: line-through; color: #999; margin-right: 8px;">
                                                Rs. @product.Price.ToString("N0")
                                            </span>
                                            <span style="color: #04ADB1; font-weight: bold;">
                                                Rs. @((product.Price - (product.Price * product.Discount / 100)).ToString("N0"))
                                            </span>
                                        </div>
                                        <div class="product-discount-badge" style="color: #f97316; font-size: 0.8rem;">
                                            @product.Discount% OFF
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="product-price" style="color: #04ADB1; font-weight: bold;">
                                            Rs. @product.Price.ToString("N0")
                                        </div>
                                    }
                                    <div class="product-stock">@product.StockQuantity in stock</div>
                                </div>
                                <div class="product-actions">
                                    <button class="btn-sm btn-view" @onclick="() => ViewProduct(product.ProductId)">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                    <button class="btn-sm btn-edit" @onclick="() => EditProduct(product.ProductId)">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <button class="btn-sm btn-delete" @onclick="() => DeleteProduct(product.ProductId)">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

