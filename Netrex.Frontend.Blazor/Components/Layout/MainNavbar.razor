@using Microsoft.AspNetCore.Components.Authorization
@using Netrex.Frontend.Application.Services.WishList
@inject IJSRuntime JS
@inject WishListStateService WishListState
@inject IWishListManager WishListManager
@inherits AuthComponentBase

@*  Logout form  *@
<form method="post" action="/logout" id="navLogoutForm"></form>

<nav>
    <div class="container-fluid">
        <div class="row align-items-center justify-content-between">

            <!-- Hamburger -->
            <div class="col-auto d-lg-none">
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#navbarOffcanvas">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <!-- Desktop Nav Links -->
            <div class="col-lg-8 col-md-7 d-none d-lg-block">
                <ul class="nav-items d-flex gap-2 mb-0 justify-content-center">
                    <li><NavLink href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                    <li><span class="disabled-link">Shop</span></li>
                    <li><span class="disabled-link">About Us</span></li>
                    <li><span class="disabled-link">Blog</span></li>
                    <li><span class="disabled-link">Contact Us</span></li>
                </ul>
            </div>

            <!-- Icons -->
            <div class="col-auto ms-auto">
                <div class="nav-icons">
                    <ul class="d-flex gap-3 mb-0 align-items-center">

                        @if (IsAuthenticated)
                        {
                            <!-- Wishlist -->
                            <li>
                                <a href="/wishlist">
                                    <div class="position-relative d-inline-block">
                                        <img src="/assets/icons/love.png"
                                             width="28" alt="Wishlist" />
                                        @if (WishListState.Count > 0)
                                        {
                                            <span class="position-absolute top-0 start-100
                                                                 translate-middle badge
                                                                 rounded-pill bg-danger"
                                                  style="font-size:10px;">
                                                @WishListState.Count
                                            </span>
                                        }
                                    </div>
                                </a>
                            </li>

                            <!-- Cart -->
                            <li class="cart">
                                <a href="/cart">
                                    <img src="/assets/icons/shopping-bag.png"
                                         width="30" alt="Cart" />
                                </a>
                            </li>

                            <!-- Profile Pic -->
                            <li class="dropdown">
                                <a href="#"
                                   class="dropdown-toggle mainnavbar__profile-toggle"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(ProfileImageUrl))
                                    {
                                        <img src="@ProfileImageUrl"
                                             class="rounded-circle object-fit-cover mainnavbar__profile-img"
                                             alt="Profile" />
                                    }
                                    else
                                    {
                                        <div class="mainnavbar__profile-avatar d-flex align-items-center
                                                                    justify-content-center rounded-circle">
                                            <span class="mainnavbar__profile-initial fw-bold">
                                                @CurrentUserName.FirstOrDefault()
                                            </span>
                                        </div>
                                    }
                                </a>

                                @* Dropdown Menu *@
                                <ul class="dropdown-menu dropdown-menu-end mainnavbar__dropdown">

                                    @* User Info *@
                                    <li class="mainnavbar__dropdown-header px-3 py-2">
                                        <p class="fw-bold mb-0">@CurrentUserName</p>
                                        <small class="mainnavbar__dropdown-role">
                                            @CurrentUserRole
                                        </small>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    @* Profile *@
                                    <li>
                                        <a class="dropdown-item mainnavbar__dropdown-item"
                                           href="/profile">
                                            <i class="fas fa-user me-2"></i>
                                            My Profile
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    @* Logout *@
                                    <li>
                                        <a class="dropdown-item mainnavbar__dropdown-logout"
                                           href="#"
                                           @onclick="Logout"
                                           @onclick:preventDefault="true">
                                            <i class="fas fa-sign-out-alt me-2"></i>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Login -->
                            <li>
                                <NavLink href="/login"
                                         class="d-flex align-items-center gap-1
                                                    navbar__login-link">
                                    <img src="/assets/icons/people.png" width="28" />
                                    <span class="navbar__login-text">Login</span>
                                </NavLink>
                            </li>
                        }

                        <!-- Become a Seller -->
                        <li class="nav-item ms-2">
                            <a href="/sellerregister"
                               class="btn btn-outline-light btn-sm px-4 py-2
                                      rounded-pill d-flex align-items-center
                                      gap-2 fw-semibold shadow-sm custom-sell-btn">
                                <i class="fas fa-store"></i>
                                <span>Become a Seller</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Offcanvas -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="navbarOffcanvas">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close"
                    data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            @if (IsAuthenticated)
            {
                <div class="d-flex align-items-center gap-3 p-3 mb-3 navbar__mobile-profile">
                    <img src="@(ProfileImageUrl ?? "/assets/icons/people.png")"
                         width="45" height="45"
                         class="rounded-circle object-fit-cover nav-profile-img"
                         alt="Profile" />
                    <div>
                        <p class="text-white fw-bold mb-0">@CurrentUserName</p>
                        <small class="nav-role-text">@CurrentUserRole</small>
                    </div>
                </div>
            }

            <ul class="nav-items-mobile">
                <li><NavLink href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                <li><span class="disabled-link">Shop</span></li>
                <li><span class="disabled-link">About Us</span></li>
                <li><span class="disabled-link">Blog</span></li>
                <li><span class="disabled-link">Contact Us</span></li>
                @if (IsAuthenticated)
                {
                    <li><a href="/profile">My Profile</a></li>
                    <li><a href="/orders">My Orders</a></li>
                    <li>
                        <a href="#"
                           @onclick="Logout"
                           @onclick:preventDefault="true"
                           class="navbar__logout-link">
                            Logout
                        </a>
                    </li>
                }
                else
                {
                    <li><a href="/login">Login</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    private string? ProfileImageUrl;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        WishListState.OnCountChanged += async () =>
            await InvokeAsync(StateHasChanged);

        if (IsAuthenticated)
        {
            await LoadCountAsync();
        }
    }

    private async Task LoadCountAsync()
    {
        var response = await WishListManager
            .GetWishListCountAsync(CurrentUserId);
        if (response.IsSuccess)
            WishListState.SetCount(response.Data);
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync(
            "eval",
            "document.getElementById('navLogoutForm').submit()"
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                var tooltipTriggerList = [].slice.call(
                    document.querySelectorAll('[data-bs-toggle=""tooltip""]'));
                tooltipTriggerList.map(function (el) {
                    return new bootstrap.Tooltip(el);
                });
            ");
        }
    }

    public void Dispose()
    {
        WishListState.OnCountChanged -= async () =>
            await InvokeAsync(StateHasChanged);
    }
}
