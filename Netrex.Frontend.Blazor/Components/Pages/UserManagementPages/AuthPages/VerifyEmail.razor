@page "/verify-email"
@inject NavigationManager Navigation

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Create your account and start selling smarter.</p>
        </div>
        <div class="auth-right">
            <h2>Forget Password</h2>
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger py-2" style="font-size: 0.8rem;">@ErrorMessage</div>
            }

            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/email-icon.png" />
                </span>
                <input @bind="Email" type="email" class="form-control" placeholder="Email" />
            </div>

            <button class="btn btn-primary w-100" @onclick="VerifyAndRedirect" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Verify Email</span>
                }
            </button>

            <div class="auth-footer mt-3">
                <div class="auth-footer-links text-center">
                    Back To Login <a href="/login" class="text-primary fw-bold text-decoration-none">Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string Email { get; set; } = "";
    private string? ErrorMessage { get; set; }
    private bool IsProcessing { get; set; }

    private async Task VerifyAndRedirect()
    {
        ErrorMessage = null;

        // Basic Email Validation
        if (string.IsNullOrWhiteSpace(Email) || !Email.Contains("@"))
        {
            ErrorMessage = "Please enter a valid email address.";
            return;
        }

        IsProcessing = true;
        
        // Yahan aap apna API call kar saktay hain OTP bhejne ke liye
        await Task.Delay(1500); 

        IsProcessing = false;
        
        // Redirecting to Reset Password page
        Navigation.NavigateTo("/reset-password");
    }
}