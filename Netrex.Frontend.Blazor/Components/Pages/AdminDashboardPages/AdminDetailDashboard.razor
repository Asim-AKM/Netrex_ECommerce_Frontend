    <section id="ad-settings" class="ad-section">
        <h2>Settings</h2>
        <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 300px;">
                <h3 style="color: #000000; margin-bottom: 1rem;">Account Settings</h3>
                <form style="background: #ffffff; padding: 1.5rem; border-radius: 8px; border: 1px solid #e5e7eb;">
                    <div style="margin-bottom: 1rem;">
                        <label for="username" style="color: #000000; display: block; margin-bottom: 0.5rem;">Username</label>
                        <input type="text" id="username" name="username" style="width: 100%; padding: 0.5rem; border: 1px solid #000000; border-radius: 4px; background: #ffffff; color: #000000;" placeholder="Enter username">
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <label for="email" style="color: #000000; display: block; margin-bottom: 0.5rem;">Email</label>
                        <input type="email" id="email" name="email" style="width: 100%; padding: 0.5rem; border: 1px solid #000000; border-radius: 4px; background: #ffffff; color: #000000;" placeholder="Enter email">
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <label for="password" style="color: #000000; display: block; margin-bottom: 0.5rem;">Password</label>
                        <input type="password" id="password" name="password" style="width: 100%; padding: 0.5rem; border: 1px solid #000000; border-radius: 4px; background: #ffffff; color: #000000;" placeholder="Enter password">
                    </div>
                    <button type="submit" class="ad-btn">Save Changes</button>
                </form>
            </div>
            <div style="flex: 1; min-width: 300px;">
                <h3 style="color: #000000; margin-bottom: 1rem;">Profile</h3>
                <form style="background: #ffffff; padding: 1.5rem; border-radius: 8px; border: 1px solid #e5e7eb;">
                    <div style="margin-bottom: 1rem;">
                        <label for="fullname" style="color: #000000; display: block; margin-bottom: 0.5rem;">Full Name</label>
                        <input type="text" id="fullname" name="fullname" style="width: 100%; padding: 0.5rem; border: 1px solid #000000; border-radius: 4px; background: #ffffff; color: #000000;" placeholder="Enter full name">
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <label for="bio" style="color: #000000; display: block; margin-bottom: 0.5rem;">Bio</label>
                        <textarea id="bio" name="bio" style="width: 100%; padding: 0.5rem; border: 1px solid #000000; border-radius: 4px; background: #ffffff; color: #000000;" placeholder="Enter bio"></textarea>
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <label style="color: #000000; display: block; margin-bottom: 0.5rem;">Notifications</label>
                        <label style="display: flex; align-items: center; margin-bottom: 0.5rem;">
                            <input type="checkbox" style="margin-right: 0.5rem;">
                            <span style="color: #000000;">Email Notifications</span>
                        </label>
                        <label style="display: flex; align-items: center;">
                            <input type="checkbox" style="margin-right: 0.5rem;">
                            <span style="color: #000000;">Push Notifications</span>
                        </label>
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <label style="color: #000000; display: block; margin-bottom: 0.5rem;">Dark Mode</label>
                        <label class="ad-toggle-switch">
                            <input type="checkbox">
                            <span class="ad-slider"></span>
                        </label>
                    </div>
                    <button type="submit" class="ad-btn">Update Profile</button>
                </form>
            </div>
        </div>
    </section>

    @if (ShowStatusModal && PendingStatusUser != null)
    {
        <!-- Backdrop -->
        <div class="ntx-modal-backdrop" @onclick="CancelStatusChange"></div>

        <!-- Modal -->
        <div class="ntx-modal">
            <div class="ntx-modal-header">
                <div class="ntx-modal-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3>Change User Status</h3>
            </div>

            <div class="ntx-modal-body">
                <div class="ntx-modal-user-info">
                    @if (!string.IsNullOrWhiteSpace(PendingStatusUser.ImageUrl))
                    {
                        <img src="@PendingStatusUser.ImageUrl" class="ntx-modal-avatar" />
                    }
                    else
                    {
                        <div class="ntx-modal-avatar-placeholder">
                            @PendingStatusUser.FullName.Substring(0, 1).ToUpper()
                        </div>
                    }
                    <div>
                        <p class="ntx-modal-username">@PendingStatusUser.FullName</p>
                        <p class="ntx-modal-email">@PendingStatusUser.Email</p>
                    </div>
                </div>

                <div class="ntx-modal-status-change">
                    <span class="ntx-status-pill status-@PreviousStatus.ToString().ToLower()">
                        @PreviousStatus.ToString()
                    </span>
                    <i class="fa-solid fa-arrow-right ntx-arrow"></i>
                    <span class="ntx-status-pill status-@PendingNewStatus.ToString().ToLower()">
                        @PendingNewStatus.ToString()
                    </span>
                </div>

                <p class="ntx-modal-warning">
                    Are you sure you want to change this user's status?
                    This action will take effect immediately.
                </p>
            </div>

            <div class="ntx-modal-footer">
                <button class="ntx-modal-btn cancel" @onclick="CancelStatusChange">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </button>
                <button class="ntx-modal-btn confirm" @onclick="ConfirmStatusChange">
                    <i class="fa-solid fa-check"></i> Yes, Change It
                </button>
            </div>
        </div>
    }


    @* Payout Modal *@
    @if (ShowPayoutModal && SelectedPayout != null)
    {
        <div class="ntx-modal-backdrop" @onclick="() => ShowPayoutModal = false"></div>
        <div class="ntx-modal">
            <div class="ntx-modal-header">
                <div class="ntx-modal-icon">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <h3>Seller Payout Details</h3>
            </div>
            <div class="ntx-modal-body">
                <div class="ntx-payout-details">
                    <div class="ntx-payout-row">
                        <span class="ntx-payout-label">Payout ID</span>
                        <span class="ntx-payout-value">@SelectedPayout.SellerPayoutId.ToString().Substring(0, 8)...</span>
                    </div>
                    <div class="ntx-payout-row">
                        <span class="ntx-payout-label">Order ID</span>
                        <span class="ntx-payout-value">@SelectedPayout.OrderId.ToString().Substring(0, 8)...</span>
                    </div>
                    <div class="ntx-payout-row">
                        <span class="ntx-payout-label">Amount</span>
                        <span class="ntx-payout-value">@SelectedPayout.AmountToPay.ToString("C")</span>
                    </div>
                    <div class="ntx-payout-row">
                        <span class="ntx-payout-label">Status</span>
                        <span class="ntx-status-pill status-@SelectedPayout.PaymentStatus.ToString()">
                            @SelectedPayout.PaymentStatus.ToString()
                        </span>
                    </div>
                    <div class="ntx-payout-row">
                        <span class="ntx-payout-label">Payout Date</span>
                        <span class="ntx-payout-value">
                            @(SelectedPayout.PayOutDate == default(DateTime)
                                                    ? "Not paid yet"
                                                    : SelectedPayout.PayOutDate.ToString("MMM dd, yyyy"))
                    </span>
                </div>
            </div>
        </div>
        <div class="ntx-modal-footer">
            <button class="ntx-modal-btn cancel"
                    @onclick="() => ShowPayoutModal = false">
                <i class="fa-solid fa-xmark"></i> Close
            </button>
            @if (SelectedPayout.PaymentStatus != PaymentStatus.success)
                {
                    <button class="ntx-modal-btn confirm"
                            @onclick="() => MarkAsPaid(SelectedPayout.SellerPayoutId)">
                        <i class="fa-solid fa-check"></i> Mark as Paid
                    </button>
                }
            </div>
        </div>
    }
</main>

