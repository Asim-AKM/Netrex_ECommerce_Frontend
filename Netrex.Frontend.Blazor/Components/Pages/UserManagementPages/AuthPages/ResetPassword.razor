@page "/reset-password"

<div class="container-fluid d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="auth-wrapper">
        <div class="auth-left">
            <h1>NETREX<br />ECOMMERCE</h1>
            <p>Create your account and start selling smarter.</p>
        </div>
        <div class="auth-right">
            <h2>Reset Password</h2>
            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/User Male Ganja.png" />
                </span>
                <input type="text" name="Otp" class="form-control" placeholder="Enter OTP" />
            </div>
            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/Lock black.png" />
                </span>
                <input name="Password" id="password" type="password" class="form-control" placeholder="Password" />
                <span class="toggle-password" onclick="togglePassword()">
                    <img id="eyeIcon" src="assets/user-management-assets/icons/monkey-password-hide.png" style="height:25px" />
                </span>
            </div>
            <div class="input-group mb-3">
                <span class="icon">
                    <img src="assets/user-management-assets/icons/Lock black.png" />
                </span>
                <input name="ConfirmPassword" id="confirmPassword" type="password" class="form-control" placeholder="Confirm Password" required />
            </div>
            <button class="btn btn-primary w-100">Reset</button>
            <div class="auth-footer mt-3">
                <div class="auth-footer-links">
                    Back To Login <a href="/login">Login</a>
                </div>
            </div>
        </div>
    </div>
</div>