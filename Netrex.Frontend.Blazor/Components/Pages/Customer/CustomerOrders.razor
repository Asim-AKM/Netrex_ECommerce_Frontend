@page "/customer/orders"
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<div class="customer-card">
    <div class="customer-card-header">
        <h5 class="customer-card-title">My Orders</h5>
    </div>
    <div class="customer-card-body">
        @if (IsLoading)
        {
            <p>Loading orders...</p>
        }
        else if (orders == null || !orders.Any())
        {
            <div class="text-center py-4 customer-empty-orders">
                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                <p>You have not created any order yet</p>
                <a href="/customer/dashboard" class="btn customer-btn-primary">
                    Continue Shopping
                </a>
            </div>
        }
        else
        {
            <div class="customer-orders-list" id="spOrdersList">

                @foreach (var order in orders)
                {
                    <div class="customer-order-card mb-3 p-3" data-order-id="@order.OrderId">

                        <div class="row align-items-center">

                            <div class="col-md-8">

                                <h6>Order #@order.OrderId</h6>

                                <p class="text-muted mb-1">
                                    Placed on @order.CreatedAt.ToString("dd MMM yyyy")
                                </p>

                                @if (order.OrderStatus)
                                {
                                    <span class="customer-badge customer-badge-success">
                                        Delivered
                                    </span>
                                }
                                else
                                {
                                    <span class="customer-badge customer-badge-warning">
                                        Pending
                                    </span>
                                }

                            </div>

                            <div class="col-md-4 text-md-end">

                                <strong>$@order.TotalAmount</strong>

                                <br />

                                <button class="btn customer-btn-outline btn-sm mt-2"
                                        @onclick="() => ViewDetails(order.OrderId)">
                                    Details
                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    </div>
</div>