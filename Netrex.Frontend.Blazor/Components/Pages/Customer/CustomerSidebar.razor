<div class="customer-sidebar-wrapper p-3">
    <!-- User Info -->
    <div class="customer-user-info text-center mb-4">
        <div class="customer-avatar-wrapper position-relative d-inline-block">
            <img src="https://ui-avatars.com/api/?name=Saqib+Khan&size=100&background=04ADB1&color=fff&rounded=true"
                 alt="Profile" class="customer-avatar rounded-circle" width="@(IsMobile ? 70 : 90)">
            @if (!IsMobile)
            {
                <label for="customerAvatarUpload" class="customer-avatar-upload">
                    <i class="fas fa-camera"></i>
                    <input type="file" id="customerAvatarUpload" class="d-none" accept="image/*">
                </label>
            }
        </div>
        <h5 class="mt-2 customer-name">Saqib Khan</h5>
        <p class="text-muted customer-email">saqibkhanskm1@gmail.com</p>
    </div>

    <!-- Navigation Links - NavLink automatically adds 'active' class -->
    <ul class="nav flex-column customer-nav">
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/dashboard" match="NavLinkMatch.Prefix">
                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/profile">
                <i class="fas fa-user me-2"></i>Profile
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/orders">
                <i class="fas fa-box me-2"></i>Orders
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/vouchers">
                <i class="fas fa-ticket-alt me-2"></i>Vouchers
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/cart">
                <i class="fas fa-shopping-cart me-2"></i>Cart
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/settings">
                <i class="fas fa-cog me-2"></i>Settings
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/refunds">
                <i class="fas fa-undo-alt me-2"></i>Refunds
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link customer-nav-link" href="/customer/wallet">
                <i class="fas fa-wallet me-2"></i>Wallet
            </NavLink>
        </li>
        <li class="nav-item mt-4">
            <a class="nav-link customer-nav-link text-danger" href="#" @onclick="ShowLogoutModal" @onclick:preventDefault="true">
                <i class="fas fa-sign-out-alt me-2"></i>Logout
            </a>
        </li>

    </ul>
</div>

<!-- Logout Modal -->
<div class="modal fade" id="customerLogoutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Logout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to logout?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" style="background-color: #04ADB1; border-color: #04ADB1;" @onclick="Logout">Logout</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsMobile { get; set; } = false;

    [Inject] private IJSRuntime JS { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }

    private async Task ShowLogoutModal()
    {
        await JS.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('customerLogoutModal')).show()");
    }

    private void Logout()
    {
        JS.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('customerLogoutModal')).hide()");
        // Redirect to home or login page
        Navigation.NavigateTo("/", true);
    }
}