@page "/unauthorized"

<div class="auth-overlay">
    <div class="auth-card">
        <div class="card-header">
            <h1 class="error-code">401</h1>
        </div>

        <div class="card-body">
            <div class="icon-wrapper">
                <div class="lock-visual">🔒</div>
            </div>
            <h2 class="title">Access Denied!</h2>
            <p class="message">
                Please sign in to your account to access this page.
                Kindly login to continue exploring Netrex.
            </p>
        </div>

        <div class="card-footer">
            <a href="/login" class="btn-main">Login</a>
            <a href="/" class="btn-secondary">Back Home</a>
        </div>
    </div>
</div>