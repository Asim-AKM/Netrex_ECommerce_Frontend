                    {
                        <div class="row">
                            <div class="col-md-5 text-center mb-3 mb-md-0">
                                @if (selectedProduct.Images != null && selectedProduct.Images.Any())
                                {
                                    <div id="productViewCarousel" class="carousel slide" data-bs-ride="false">
                                        <div class="carousel-inner">
                                            @for (int i = 0; i < selectedProduct.Images.Count; i++)
                                            {
                                                var img = selectedProduct.Images[i];
                                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                                    <img src="@img.Url" class="d-block w-100" style="max-height: 250px; object-fit: contain;" alt="Product image">
                                                </div>
                                            }
                                        </div>
                                        @if (selectedProduct.Images.Count > 1)
                                        {
                                            <button class="carousel-control-prev" type="button" data-bs-target="#productViewCarousel" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                <span class="visually-hidden">Previous</span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#productViewCarousel" data-bs-slide="next">
                                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                <span class="visually-hidden">Next</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="border rounded p-3 bg-light">
                                        <img src="@(selectedProduct.ImageUrl ?? "/assets/placeholder.jpg")"
                                             alt="@selectedProduct.ProductName"
                                             style="max-width: 100%; max-height: 250px; object-fit: contain;"
                                             onerror="this.src='/assets/placeholder.jpg'">
                                    </div>
                                }
                            </div>
                            <div class="col-md-7">
                                <div class="product-details-info">
                                    <h4 class="mb-3">@selectedProduct.ProductName</h4>
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <th style="width: 35%; background-color: #f8f9fa; padding: 8px;">Description:</th>
                                            <td style="padding: 8px;">@selectedProduct.ProductDescription</td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Original Price:</th>
                                            <td style="padding: 8px; text-decoration: line-through; color: #999;">
                                                Rs. @selectedProduct.Price.ToString("N0")
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Discount:</th>
                                            <td style="padding: 8px; color: #f97316;">@selectedProduct.Discount% OFF</td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Final Price:</th>
                                            <td style="padding: 8px; color: #04ADB1; font-weight: bold; font-size: 1.2rem;">
                                                Rs. @((selectedProduct.Price - (selectedProduct.Price * selectedProduct.Discount / 100)).ToString("N0"))
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Category:</th>
                                            <td style="padding: 8px;"><span class="badge bg-info">@selectedProduct.CategoryName</span></td>
                                        </tr>
                                        <tr>
                                            <th style="background-color: #f8f9fa; padding: 8px;">Stock:</th>
                                            <td style="padding: 8px;">
                                                @if (selectedProduct.StockQuantity > 0)
                                                {
                                                    <span class="badge bg-success">@selectedProduct.StockQuantity units available</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Out of stock</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted">Product not found</p>
                    }
                </div>
                <div class="modal-footer">
                    @if (selectedProduct != null)
                    {
                        <button class="btn btn-primary" @onclick="EditFromViewModal">
                            <i class="fas fa-edit"></i> Edit Product
                        </button>
                        <button class="btn btn-danger" @onclick="DeleteFromViewModal">
                            <i class="fas fa-trash"></i> Delete Product
                        </button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseViewModal">
                        <i class="fas fa-times"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ EDIT PRODUCT MODAL ============ -->
@if (showEditModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 800px; margin-left:350px">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="fas fa-edit me-2"></i>
                        Edit Product
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    @if (_editModel != null)
                    {
                        <EditForm Model="_editModel" OnValidSubmit="UpdateProduct">
                            <DataAnnotationsValidator />
                            <input type="hidden" @bind-value="_editModel.ProductId" />

                            <!-- Basic Info -->
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Product Name</label>
                                <InputText class="form-control" @bind-Value="_editModel.ProductName" />
                                <ValidationMessage For="@(() => _editModel.ProductName)" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <InputText class="form-control" @bind-Value="_editModel.ProductDescription" />
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label fw-bold">Price (Rs.)</label>
                                        <InputNumber class="form-control" @bind-Value="_editModel.Price" step="0.01" />
                                        <ValidationMessage For="@(() => _editModel.Price)" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label class="form-label fw-bold">Discount (%)</label>
                                        <InputNumber class="form-control" @bind-Value="_editModel.Discount" step="0.01" min="0" max="100" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Category</label>
                                <InputSelect class="form-control" @bind-Value="_editModel.CategoryName">
                                    <option value="">-- Select Category --</option>
                                    <option value="Electronics">Electronics</option>
                                    <option value="Clothing">Clothing</option>
                                    <option value="Books">Books</option>
                                    <option value="Sports">Sports</option>
                                    <option value="Home & Kitchen">Home & Kitchen</option>
                                </InputSelect>
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Stock Quantity</label>
                                <InputNumber class="form-control" @bind-Value="_editModel.StockQuantity" />
                            </div>

                            <!-- ===== EXISTING IMAGES ===== -->
                            @if (_editModel.Images != null && _editModel.Images.Any())
                            {
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Current Images</label>
                                    <div class="d-flex flex-wrap gap-3 border rounded p-3 bg-light">
                                        @for (int i = 0; i < _editModel.Images.Count; i++)
                                        {
                                            var currentIndex = i;
                                            var img = _editModel.Images[i];
                                            <div class="position-relative" style="width: 100px;">
                                                <img src="@img.Url" style="width:100px; height:100px; object-fit:cover;" class="border rounded" />
                                                @if (img.IsPrimary)
                                                {
                                                    <span class="badge bg-primary position-absolute top-0 start-0">Primary</span>
                                                }
                                                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 bg-danger rounded-circle"
                                                        style="transform: translate(50%, -50%); width: 20px; height: 20px; font-size: 10px;"
                                                        @onclick="() => RemoveExistingImage(currentIndex)">
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- ===== ADD NEW IMAGES ===== -->
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Add New Images (Max 5, 2.5MB each)</label>
                                <InputFile OnChange="OnEditImagesSelected" multiple accept="image/*" />
                                @if (_newImagePreviews.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @for (int i = 0; i < _newImagePreviews.Count; i++)
                                        {
                                            var currentIndex = i;
                                            <div class="position-relative">
                                                <img src="@_newImagePreviews[i]" style="width:80px; height:80px; object-fit:cover;" class="border rounded" />
                                                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 bg-danger rounded-circle"
                                                        style="transform: translate(50%, -50%); width: 18px; height: 18px; font-size: 8px;"
                                                        @onclick="() => RemoveNewImage(currentIndex)">
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_editImageError))
                                {
                                    <div class="text-danger small mt-1">@_editImageError</div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(EditErrorMessage))
                            {
                                <div class="alert alert-danger">@EditErrorMessage</div>
                            }

                            <div class="modal-footer px-0 pb-0">
                                <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                                <button type="submit" class="btn btn-warning" disabled="@isUpdating">
                                    @if (isUpdating)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="fas fa-save"></i> @(isUpdating ? "Updating..." : "Update Product")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ DELETE CONFIRMATION MODAL ============ -->
@if (showDeleteModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-trash me-2"></i>
                        Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    @if (selectedProduct != null)
                    {
                        <div class="text-center mb-4">
                            <img src="@(selectedProduct.ImageUrl ?? "/assets/placeholder.jpg")"
                                 alt="@selectedProduct.ProductName"
                                 style="max-width: 120px; max-height: 120px; border-radius: 8px; border: 1px solid #dee2e6; padding: 5px;">
                        </div>
                        <p class="text-center fs-5">Are you sure you want to delete <strong class="text-danger">@selectedProduct.ProductName</strong>?</p>
                        <p class="text-center text-muted">This action cannot be undone!</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteProduct" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fas fa-trash"></i> @(isDeleting ? "Deleting..." : "Delete Permanently")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ SUCCESS MODAL ============ -->
@if (IsSuccessModalVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-success">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-check-circle me-2"></i>
                        Success
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideSuccessModal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-0 fs-5">@Message</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsModalVisible = false;
    private bool IsSuccessModalVisible = false;
    private bool isSaving = false;
    private List<ProductsVm> products = new();
    private bool isLoadingProducts = false;

    ProductsVm _model = new();
    List<byte[]> ImageBytesList = new();
    List<string> ImageNames = new();
    List<string> ImagePreviews = new();

    string? ErrorMessage;
    string Message = "";

    const long MaxFileSize = 2_621_440;
    const int MaxFiles = 5;

    void ShowModal() => IsModalVisible = true;

    void HideModal()
    {
        IsModalVisible = false;
        _model = new ProductsVm();
        ImageBytesList.Clear();
        ImageNames.Clear();
        ImagePreviews.Clear();
        ErrorMessage = null;
        StateHasChanged();
    }

    void HideSuccessModal()
    {
        IsSuccessModalVisible = false;
        Message = "";
        StateHasChanged();
    }

    void RemoveImage(int index)
    {
        if (index < 0 || index >= ImagePreviews.Count)
            return;

        ImagePreviews.RemoveAt(index);
        ImageBytesList.RemoveAt(index);
        ImageNames.RemoveAt(index);
        StateHasChanged();
    }

    async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var files = e.GetMultipleFiles(MaxFiles);
        if (files.Count + ImageBytesList.Count > MaxFiles)
        {
            ErrorMessage = $"Maximum {MaxFiles} images allowed.";
            return;
        }
        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                ErrorMessage = $"Image {file.Name} is larger than 2.5MB.";
                continue;
            }
            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ImageBytesList.Add(ms.ToArray());
            ImageNames.Add(file.Name);
            ImagePreviews.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            isLoadingProducts = true;
            StateHasChanged();

            var response = await ProductManager.GetAllProductsAsync(CurrentUserId);

            if (response.IsSuccess)
            {
                products = response.Data ?? new();
                Console.WriteLine($"✅ {products.Count} products loaded");
            }
            else
            {
                Console.WriteLine($"❌ Failed: {response.Message}");
                products = new List<ProductsVm>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error: {ex.Message}");
            products = new List<ProductsVm>();
        }
        finally
        {
            isLoadingProducts = false;
            StateHasChanged();
        }
    }

    async Task SaveProduct()
    {
        if (!ImageBytesList.Any())
        {
            ErrorMessage = "Please upload at least one image.";
            return;
        }
        try
        {
            isSaving = true;
            StateHasChanged();

            var result = await ProductManager.AddProducts(_model, ImageBytesList, ImageNames, CurrentUserId);

            if (result.IsSuccess)
            {
                await LoadProductsAsync();
                Message = "Product saved successfully ✅";
                HideModal();
                IsSuccessModalVisible = true;
                StateHasChanged();
            }
            else
            {
                ErrorMessage = result.Message ?? "Something went wrong ❌";
                StateHasChanged();
            }
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private ProductsVm? selectedProduct = null;
    private bool showViewModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private bool isUpdating = false;
    private string? EditErrorMessage;
    private ProductsVm _editModel = new();

    // Edit modal ke liye naye images ke liye lists
    private List<byte[]> _newImageBytes = new();
    private List<string> _newImageNames = new();
    private List<string> _newImagePreviews = new();
    private string? _editImageError;

    private void ViewProduct(Guid productId)
    {
        Console.WriteLine($"ViewProduct called with ID: {productId}");
        selectedProduct = products.FirstOrDefault(p => p.ProductId == productId);
        if (selectedProduct != null)
        {
            showViewModal = true;
            StateHasChanged();
        }
    }

    private void CloseViewModal()
    {
        showViewModal = false;
        StateHasChanged();
    }

    private void EditProduct(Guid productId)
    {
        var product = products.FirstOrDefault(p => p.ProductId == productId);
        if (product != null)
        {
            selectedProduct = product;
            _editModel = new ProductsVm
            {
                ProductId = product.ProductId,
                ProductName = product.ProductName ?? string.Empty,
                ProductDescription = product.ProductDescription ?? string.Empty,
                Price = product.Price,
                Discount = product.Discount,
                CategoryName = product.CategoryName ?? string.Empty,
                StockQuantity = product.StockQuantity,
                ImageUrl = product.ImageUrl ?? string.Empty,
                CloudPublicId = product.CloudPublicId ?? string.Empty,
                // ✅ Copy existing images
                Images = product.Images?.Select(img => new CloudinaryUploadResult
                {
                    Url = img.Url,
                    CloudPublicId = img.CloudPublicId,
                    IsPrimary = img.IsPrimary
                }).ToList() ?? new List<CloudinaryUploadResult>()
            };
            // Clear any previous new images
            _newImageBytes.Clear();
            _newImageNames.Clear();
            _newImagePreviews.Clear();
            _editImageError = null;
            showEditModal = true;
            StateHasChanged();
        }
    }

    private void EditFromViewModal()
    {
        if (selectedProduct != null)
        {
            showViewModal = false;
            EditProduct(selectedProduct.ProductId);
        }
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        _editModel = new ProductsVm();
        _newImageBytes.Clear();
        _newImageNames.Clear();
        _newImagePreviews.Clear();
        _editImageError = null;
        EditErrorMessage = null;
        StateHasChanged();
    }

    // Remove existing image from _editModel.Images
    private void RemoveExistingImage(int index)
    {
        if (index >= 0 && index < _editModel.Images.Count)
        {
            var removedImage = _editModel.Images[index];
            _editModel.Images.RemoveAt(index);
            Console.WriteLine($"✅ Removed image: {removedImage.Url}");
            StateHasChanged();
        }
    }

    // Handle new image selection in edit modal
    private async Task OnEditImagesSelected(InputFileChangeEventArgs e)
    {
        _editImageError = null;
        var files = e.GetMultipleFiles(5);
        if (files.Count + _newImageBytes.Count > 5)
        {
            _editImageError = "Maximum 5 images allowed.";
            return;
        }
        foreach (var file in files)
        {
            if (file.Size > 2_621_440) // 2.5MB
            {
                _editImageError = $"Image {file.Name} is larger than 2.5MB.";
                continue;
            }
            using var stream = file.OpenReadStream(2_621_440);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _newImageBytes.Add(ms.ToArray());
            _newImageNames.Add(file.Name);
            _newImagePreviews.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
        StateHasChanged();
    }

    // Remove newly selected image (before upload)
    private void RemoveNewImage(int index)
    {
        if (index >= 0 && index < _newImageBytes.Count)
        {
            _newImageBytes.RemoveAt(index);
            _newImageNames.RemoveAt(index);
            _newImagePreviews.RemoveAt(index);
            StateHasChanged();
        }
    }

    private async Task UpdateProduct()
    {
        try
        {
            isUpdating = true;
            EditErrorMessage = null;
            StateHasChanged();

            // Debugging: Check what's being sent
            Console.WriteLine($"Sending {_editModel.Images?.Count ?? 0} existing images");
            foreach (var img in _editModel.Images ?? new())
            {
                Console.WriteLine($"- Image: {img.Url}, IsPrimary: {img.IsPrimary}");
            }

            // Call ProductManager with new images (if any)
            var response = await ProductManager.UpdateProducts(
                _editModel,
                _newImageBytes.Any() ? _newImageBytes : null,
                _newImageNames.Any() ? _newImageNames : null
            );

            if (response.IsSuccess)
            {
                await LoadProductsAsync();
                CloseEditModal();
                Message = "Product updated successfully ✅";
                IsSuccessModalVisible = true;
                StateHasChanged();
            }
            else
            {
                EditErrorMessage = response.Message ?? "Update failed";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            EditErrorMessage = $"Error: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private void DeleteProduct(Guid productId)
    {
        Console.WriteLine($"DeleteProduct called - ProductId: {productId}");
        selectedProduct = products.FirstOrDefault(p => p.ProductId == productId);
        if (selectedProduct != null)
        {
            showDeleteModal = true;
            StateHasChanged();
        }
    }

    private void DeleteFromViewModal()
    {
        if (selectedProduct != null)
        {
            showViewModal = false;
            showDeleteModal = true;
            StateHasChanged();
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task ConfirmDeleteProduct()
    {
        if (selectedProduct == null) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            var response = await ProductManager.RemoveProducts(selectedProduct.ProductId);

            Console.WriteLine($"Delete response: IsSuccess={response.IsSuccess}, Message={response.Message}");

            if (response.IsSuccess)
            {
                await LoadProductsAsync();
                Message = "Product deleted successfully ✅";

                CloseDeleteModal();

                await Task.Delay(150);

                IsSuccessModalVisible = true;
                StateHasChanged();
            }
            else
            {
                ErrorMessage = response.Message ?? "Delete failed";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Delete exception: {ex}");
            StateHasChanged();
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    public async Task RefreshProducts()
    {
        await LoadProductsAsync();
    }
}