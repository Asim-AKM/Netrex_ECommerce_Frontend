</section>
<!-- END: Meet the Team Section -->
<!-- BEGIN: Call to Action -->
<section class="cta-section text-center" data-purpose="cta-section">
    <div class="container">
        <h2 class="h2 fw-bold mb-4">Join the Netrex Community</h2>
        <p class="mb-5 lead opacity-75 mx-auto" style="max-width: 600px;">Experience the perfect blend of quality and service. Start your journey with us today.</p>
        <button class="btn btn-netrex-white px-5 py-3">
            Explore Our Catalog
        </button>
    </div>
</section>
