@page "/admindashboard"
@using Domain_Service.Enums
@using Netrex.Frontend.Application.Commons.Enums
@using Netrex.Frontend.Application.ViewModels.SellerModule
@using Netrex.Frontend.Blazor.Components.Layout.AdmindashboardLayout
@layout MainAdmindashboardLayout
@inherits AuthComponentBase
<aside class="ad-sidebar">

    <div class="sidebar-header" style="display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;">
        <img src="/assets/sellerassets/Pictures/Logo_for_Netrex-.png" alt="Netrex Logo" style="height: 50px;width: auto; padding-left:10px">

        <i class="fa-solid fa-xmark close-icon  " style="padding-left:20px;"></i>

    </div>

    <ul class="ntx-admin-nav list-unstyled">
        <li>
            <a href="#dashboard" class="ntx-nav-link active" onclick="showTab('dashboard', event)">
                <i class="fa-solid fa-gauge-high"></i>
                <span>Dashboard</span>
            </a>
        </li>
        <li>
            <a href="#UserManagment" class="ntx-nav-link" onclick="showTab('UserManagment', event)">
                <i class="fa-solid fa-user-gear"></i>
                <span>User Management</span>
            </a>
        </li>
        <li>
            <a href="#SellerModule" class="ntx-nav-link" onclick="showTab('SellerModule', event)">
                <i class="fa-solid fa-store"></i>
                <span>Seller Module</span>
            </a>
        </li>
        <li>
            <a href="#ProductManagment" class="ntx-nav-link" onclick="showTab('ProductManagment', event)">
                <i class="fa-solid fa-boxes-stacked"></i>
                <span>Product Management</span>
            </a>
        </li>
        <li>
            <a href="#customers" class="ntx-nav-link" onclick="showTab('customers', event)">
                <i class="fa-solid fa-cart-flatbed-suitcase"></i>
                <span>Customer & Order</span>
            </a>
        </li>
        <li>
            <a href="#analytics" class="ntx-nav-link" onclick="showTab('analytics', event)">
                <i class="fa-solid fa-chart-simple"></i>
                <span>Analytics</span>
            </a>
        </li>
        <li>
            <a href="#reports" class="ntx-nav-link" onclick="showTab('reports', event)">
                <i class="fa-solid fa-file-invoice-dollar"></i>
                <span>Reports</span>
            </a>
        </li>
        <li>
            <a href="#settings" class="ntx-nav-link" onclick="showTab('settings', event)">
                <i class="fa-solid fa-sliders"></i>
                <span>Settings</span>
            </a>
        </li>
    </ul>
</aside>

<main class="ad-main-content">

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="ntx-toast @(IsSuccess ? "ntx-toast-success" : "ntx-toast-error")">
            <i class="fa-solid @(IsSuccess ? "fa-circle-check" : "fa-circle-xmark")"></i>
            @StatusMessage
        </div>
    }

    <section id="ad-dashboard" class="ad-section">
        <h2>Dashboard Overview</h2>

        <div class="ad-dashboard-cards">
            <div class="ad-card sales">
                <h3>Total Sales</h3>
                <p>$12,345</p>
                <div class="ad-sparkline">
                    <svg viewBox="0 0 100 30">
                        <path d="M0,20 L10,18 L20,22 L30,15 L40,25 L50,10 L60,20 L70,12 L80,18 L90,8 L100,15"
                              stroke="#6366f1" stroke-width="2" fill="none" />
                    </svg>
                </div>
            </div>

            <div class="ad-card orders">
                <h3>Orders</h3>
                <p>156</p>
                <div class="ad-sparkline">
                    <svg viewBox="0 0 100 30">
                        <path d="M0,25 L10,20 L20,15 L30,22 L40,18 L50,12 L60,25 L70,10 L80,20 L90,15 L100,8"
                              stroke="#f59e0b" stroke-width="2" fill="none" />
                    </svg>
                </div>
            </div>

            <div class="ad-card customers">
                <h3>Customers</h3>
                <p>89</p>
                <div class="ad-sparkline">
                    <svg viewBox="0 0 100 30">
                        <path d="M0,20 L10,15 L20,25 L30,10 L40,20 L50,15 L60,8 L70,22 L80,18 L90,12 L100,25"
                              stroke="#10b981" stroke-width="2" fill="none" />
                    </svg>
                </div>
            </div>

            <div class="ad-card products">
                <h3>Products</h3>
                <p>234</p>
                <div class="ad-sparkline">
                    <svg viewBox="0 0 100 30">
                        <path d="M0,15 L10,20 L20,10 L30,25 L40,15 L50,8 L60,22 L70,18 L80,12 L90,25 L100,10"
                              stroke="#3b82f6" stroke-width="2" fill="none" />
                    </svg>
                </div>
            </div>

            <div class="ad-card sellers">
                <h3>Sellers</h3>
                <p>45</p>
                <div class="ad-sparkline">
                    <svg viewBox="0 0 100 30">
                        <path d="M0,22 L10,18 L20,25 L30,12 L40,20 L50,15 L60,8 L70,22 L80,10 L90,18 L100,12"
                              stroke="#8b5cf6" stroke-width="2" fill="none" />
                    </svg>
                </div>
            </div>

            <div class="ad-card payments">
                <h3>Payments</h3>
                <p>$8,900</p>
                <div class="ad-sparkline">
                    <svg viewBox="0 0 100 30">
                        <path d="M0,18 L10,22 L20,15 L30,25 L40,10 L50,20 L60,12 L70,18 L80,8 L90,22 L100,15"
                              stroke="#ef4444" stroke-width="2" fill="none" />
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <section id="ad-user-management" class="ad-section">
        <h2>Customer Management</h2>

        <div class="ad-table-wrapper">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>CreatedAt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsUserLoading)
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;">Loading users...</td>
                        </tr>
                    }
                    else if (Users != null && Users.Any())
                    {
                        @foreach (var user in Users)
                        {
                            <tr>
                                <td>@user.Id.ToString().Substring(0, 8)...</td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        @if (!string.IsNullOrWhiteSpace(user.ImageUrl))
                                        {
                                            <img src="@user.ImageUrl" style="width:30px; border-radius:50%;" />
                                        }
                                        @user.FullName
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>@user.RoleName.ToString()</td>
                                <td>
                                    <select @onchange="(e) => OnStatusDropdownChanged(user, e)"
                                            class="ntx-status-select status-@user.Userstatus.ToString().ToLower()">
                                        @foreach (var status in Enum.GetValues<UserStatus>())
                                        {
                                            <option value="@status" selected="@(user.Userstatus == status)">
                                                @status.ToString()
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>@user.CreateAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
   
     <div class="asd-main-content">
        <div class="container-fluid px-0">

            <!-- ── Page Heading ── -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h5 class="fw-bold mb-1" style="color:var(--secondary);">Seller Module</h5>
                    <p class="text-muted small mb-0">Manage seller registrations, approvals and payouts</p>
                </div>
            </div>

            <!-- ── Stat Cards (reuse .ad-card pattern) ── -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="ad-card sales d-flex align-items-center gap-3 py-3">
                        <div class="slr-stat-icon" style="background:rgba(4,173,177,0.1);color:#04ADB1;">🏪</div>
                        <div>
                            <div class="fw-bold fs-5" style="color:var(--secondary);">@(sellers?.Count ?? 0)</div>
                            <div class="text-muted" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;">Total Sellers</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="ad-card orders d-flex align-items-center gap-3 py-3">
                        <div class="slr-stat-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b;">⏳</div>
                        <div>
                            <div class="fw-bold fs-5" style="color:var(--secondary);">@(sellers?.Count(s => s.Status == "Pending") ?? 0)</div>
                            <div class="text-muted" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;">Pending</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="ad-card customers d-flex align-items-center gap-3 py-3">
                        <div class="slr-stat-icon" style="background:rgba(16,185,129,0.1);color:#10b981;">✅</div>
                        <div>
                            <div class="fw-bold fs-5" style="color:var(--secondary);">@(sellers?.Count(s => s.Status == "Approved") ?? 0)</div>
                            <div class="text-muted" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;">Approved</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="ad-card payments d-flex align-items-center gap-3 py-3">
                        <div class="slr-stat-icon" style="background:rgba(239,68,68,0.1);color:#ef4444;">🚫</div>
                        <div>
                            <div class="fw-bold fs-5" style="color:var(--secondary);">@(sellers?.Count(s => s.Status == "Suspended") ?? 0)</div>
                            <div class="text-muted" style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;">Suspended</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Table Card (reuse .ad-table-wrapper) ── -->
            <div class="ad-table-wrapper">

                <!-- Tabs + Search -->
                <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-3">
                    <ul class="nav slr-tabs border-bottom w-100 w-md-auto">
                        @foreach (var tab in new[] { "All", "Pending", "Approved", "Rejected", "Suspended" })
                        {
                            <li class="nav-item">
                                <button class="nav-link px-3 py-2 @(activeTab == tab ? "active" : "")"
                                        @onclick="() => activeTab = tab">
                                    @tab
                                    @if (tab == "Pending" && (sellers?.Count(s => s.Status == "Pending") ?? 0) > 0)
                                    {
                                        <span class="badge ms-1 text-dark" style="background:#fef3c7;font-size:.7rem;">
                                            @sellers!.Count(s => s.Status == "Pending")
                                        </span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>

                    <!-- Search — reuse .ad-search-container style -->
                    <div class="ad-search-container" style="flex:0 1 260px;min-width:200px;">
                        <input type="text"
                               placeholder="Search store or address..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>
                </div>

                <!-- Table -->
                @if (isLoading)
                {
                    <div class="text-center py-5 text-muted">
                        <div class="spinner-border mb-2" style="color:var(--primary);" role="status"></div>
                        <p class="small">Loading sellers...</p>
                    </div>
                }
                else if (!FilteredSellers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <div style="font-size:2.5rem;" class="mb-2">🏪</div>
                        <p class="small mb-0">No sellers found for this filter.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="ad-table">
                            <thead>
                                <tr>
                                    <th>Seller ID</th>
                                    <th>Store</th>
                                    <th class="d-none d-md-table-cell">Address</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var seller in FilteredSellers)
                                {
                                    <tr>
                                        <!-- ID -->
                                        <td>
                                            <span class="slr-id-badge">
                                                @seller.SellerId.ToString()[..8]…
                                            </span>
                                        </td>

                                        <!-- Store -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="slr-avatar">@seller.StoreName[0]</div>
                                                <div>
                                                    <div class="fw-semibold" style="font-size:.9rem;">@seller.StoreName</div>
                                                    <div class="text-muted" style="font-size:.75rem;">@seller.Description</div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Address -->
                                        <td class="text-muted d-none d-md-table-cell" style="font-size:.88rem;">
                                            @seller.Address
                                        </td>

                                        <!-- Status — reuse ntx-status-pill -->
                                        <td>
                                            @{
                                                var pillClass = seller.Status switch
                                                {
                                                    "Approved" => "status-active",
                                                    "Pending" => "status-pending",
                                                    "Rejected" => "status-suspended",
                                                    "Suspended" => "status-inactive",
                                                    _ => "status-inactive"
                                                };
                                            }
                                            <span class="ntx-status-pill @pillClass">@seller.Status</span>
                                        </td>

                                        <!-- Actions -->
                                        <td>
                                            @if (loadingIds.Contains(seller.SellerId))
                                            {
                                                <div class="spinner-border spinner-border-sm" style="color:var(--primary);" role="status"></div>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-2 flex-wrap">
                                                    @if (seller.Status == "Pending")
                                                    {
                                                        <button class="ad-btn py-1 px-3" style="font-size:.82rem;margin-bottom:0;background:var(--success);">
                                                            ✓ Approve
                                                        </button>
                                                        <button class="ad-btn py-1 px-3" style="font-size:.82rem;margin-bottom:0;background:var(--danger);">
                                                            ✕ Reject
                                                        </button>
                                                    }
                                                    @if (seller.Status == "Approved")
                                                    {
                                                        <button class="ad-btn py-1 px-3" style="font-size:.82rem;margin-bottom:0;background:var(--warning);color:#fff;">
                                                            ⏸ Suspend
                                                        </button>
                                                        <button class="ad-btn py-1 px-3" style="font-size:.82rem;margin-bottom:0;">
                                                            💰 Payout
                                                        </button>
                                                    }
                                                    @if (seller.Status == "Suspended")
                                                    {
                                                        <button class="ad-btn py-1 px-3" style="font-size:.82rem;margin-bottom:0;background:var(--success);">
                                                            ↺ Reinstate
                                                        </button>
                                                        <button class="ad-btn py-1 px-3" style="font-size:.82rem;margin-bottom:0;">
                                                            💰 Payout
                                                        </button>
                                                    }
                                                    @if (seller.Status == "Rejected")
                                                    {
                                                        <span class="text-muted fst-italic" style="font-size:.82rem;">No actions</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div> 





    <section id="ad-product-management" class="ad-section">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2>Product Management</h2>       
        </div>

        <div class="ad-table-wrapper">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsProductsLoading)
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding: 20px;">
                                <div class="spinner-border text-primary" role="status"></div>
                                <br />Loading products...
                            </td>
                        </tr>
                    }
                    else if (Products != null && Products.Count > 0)
                    {
                        @foreach (var product in Products)
                        {
                            <tr>
                                <td>@product.ProductId.ToString().Substring(0, 8)...</td>

                                <td style="display:flex;align-items:center;gap:10px;">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             style="width:40px;height:40px;border-radius:6px;object-fit:cover;" />
                                    }
                                    <span>@product.ProductName</span>
                                </td>

                                <td>@product.CategoryName</td>

                                <td>
                                    @if (product.Discount > 0)
                                    {
                                        <div>
                                            <span style="text-decoration:line-through;color:#9ca3af; font-size: 0.85em;">
                                                @product.FormattedOriginalPrice
                                            </span><br />
                                            <strong style="color: #2563eb;">@product.FormattedFinalPrice</strong>
                                            <span style="color:green;font-size:11px; display:block;">
                                                (@product.DiscountDisplay Off)
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <strong>@product.FormattedOriginalPrice</strong>
                                    }
                                </td>

                                <td>
                                    <span class="badge @(product.StockQuantity < 10 ? "bg-danger" : "bg-success")">
                                        @product.StockQuantity
                                    </span>
                                </td>
                                <td>@product.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding: 20px; color: #6b7280;">
                                No products found in the database.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section id="ad-payment-payout" class="ad-section">
        <h2>Payment and Payout Module</h2>
        <button class="ad-btn">Process Payout</button>

        <div class="ad-table-wrapper">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Seller</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Seller A</td>
                        <td>$1,000</td>
                        <td>Pending</td>
                        <td>2023-10-01</td>
                        <td>
                            <button class="ad-btn">Approve</button>
                            <button class="ad-btn ad-btn-danger">Reject</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Seller B</td>
                        <td>$800</td>
                        <td>Completed</td>
                        <td>2023-09-28</td>
                        <td>
                            <button class="ad-btn">View</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section id="ad-cart-order" class="ad-section">
        <h2>Cart and Order Module</h2>
        <button class="ad-btn">View All Carts</button>

        <div class="ad-table-wrapper">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#12345</td>
                        <td>John Doe</td>
                        <td>$79.98</td>
                        <td>Pending</td>
                        <td>2023-10-01</td>
                        <td>
                            <button class="ad-btn">View</button>
                            <button class="ad-btn">Update</button>
                        </td>
                    </tr>
                    <tr>
                        <td>#12346</td>
                        <td>Jane Smith</td>
                        <td>$129.97</td>
                        <td>Shipped</td>
                        <td>2023-10-02</td>
                        <td>
                            <button class="ad-btn">View</button>
                            <button class="ad-btn">Update</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section id="ad-analytics" class="ad-section">
        <h2 style="font-weight:900;color:#000000;">Analytics</h2>
        <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 300px;">
                <h3 style="font-weight: 900; color: #000000; margin-bottom: 1rem;">Revenue Overview</h3>
                <svg viewBox="0 0 400 200" style="width: 100%; height: auto; border: 1px solid #e5e7eb; border-radius: 8px; background: #ffffff;">
                    <defs>
                        <linearGradient id="revenueGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.8" />
                            <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0.1" />
                        </linearGradient>
                    </defs>
                    <g transform="translate(50,20)">
                        <line x1="0" y1="150" x2="300" y2="150" stroke="#000000" stroke-width="1" />
                        <line x1="0" y1="0" x2="0" y2="150" stroke="#000000" stroke-width="1" />
                        <text x="-10" y="155" font-size="12" fill="#000000">0</text>
                        <text x="-20" y="75" font-size="12" fill="#000000">50k</text>
                        <text x="-25" y="5" font-size="12" fill="#000000">100k</text>
                        <text x="0" y="170" font-size="12" fill="#000000">Jan</text>
                        <text x="75" y="170" font-size="12" fill="#000000">Feb</text>
                        <text x="150" y="170" font-size="12" fill="#000000">Mar</text>
                        <text x="225" y="170" font-size="12" fill="#000000">Apr</text>
                        <text x="300" y="170" font-size="12" fill="#000000">May</text>
                        <path d="M0,120 L75,100 L150,80 L225,110 L300,60" stroke="url(#revenueGradient)" stroke-width="3" fill="none" />
                        <circle cx="0" cy="120" r="4" fill="#3b82f6" />
                        <circle cx="75" cy="100" r="4" fill="#3b82f6" />
                        <circle cx="150" cy="80" r="4" fill="#3b82f6" />
                        <circle cx="225" cy="110" r="4" fill="#3b82f6" />
                        <circle cx="300" cy="60" r="4" fill="#3b82f6" />
                    </g>
                </svg>
            </div>
            <div style="flex: 1; min-width: 300px;">
                <h3 style="font-weight: 900; color: #000000; margin-bottom: 1rem;">Sales by Category</h3>
                <svg viewBox="0 0 400 200" style="width: 100%; height: auto; border: 1px solid #e5e7eb; border-radius: 8px; background: #ffffff;">
                    <g transform="translate(50,20)">
