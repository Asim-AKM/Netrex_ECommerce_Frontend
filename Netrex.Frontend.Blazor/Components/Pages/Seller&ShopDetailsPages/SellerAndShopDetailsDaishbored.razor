                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="tel" class="form-control" id="editSellerPhone">
                </div>
                <div class="form-group">
                    <label>Bio</label>
                    <textarea class="form-control" id="editSellerBio" rows="3"></textarea>
                </div>
                <button class="btn-primary" onclick="saveProfileChanges()">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============ ADD PRODUCT MODAL (Blazor version) ============ -->
@if (IsModalVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); margin-left:135px">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Product</h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <EditForm Model="_model" OnValidSubmit="SaveProduct">
                        <DataAnnotationsValidator />
                        <div class="form-group mb-2">
                            <label>Product Name <span class="image-required">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.ProductName" />
                        </div>
                        <div class="form-group mb-2">
                            <label>Description <span class="image-required">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.ProductDescription" />
                        </div>
                        <div class="form-group mb-2">
                            <label>Price <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.Price" step="0.01" />
                        </div>
                        <div class="form-group mb-2">
                            <label>Discount (%) <span style="color: #6c757d; font-size: 0.8rem;">(0-100)</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.Discount" step="0.01" min="0" max="100" />
                            <small class="text-muted">Enter percentage (e.g., 10 for 10% off)</small>
                        </div>
                        <div class="form-group mb-2">
                            <label>Category <span class="image-required">*</span></label>
                            <InputSelect class="form-control" @bind-Value="_model.CategoryName">
                                <option value="">-- Select Category --</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Clothing">Clothing</option>
                                <option value="Books">Books</option>
                                <option value="Sports">Sports</option>
                                <option value="Home & Kitchen">Home & Kitchen</option>
                            </InputSelect>
                        </div>
                        <div class="form-group mb-2">
                            <label>Stock <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.StockQuantity" />
                        </div>
                        <div class="form-group mb-2">
                            <label>Product Images (Max 5, 2.5MB each)</label>
                            <InputFile OnChange="OnImagesSelected" multiple accept="image/*" />
                            @if (ImagePreviews.Any())
                            {
                                <div class="image-preview mt-2 d-flex flex-wrap">
                                    @for (int i = 0; i < ImagePreviews.Count; i++)
                                    {
                                        var currentIndex = i;
                                        <div class="position-relative me-2 mb-2">
                                            <img src="@ImagePreviews[i]" style="width:90px; height:90px; object-fit:cover;" class="rounded" />
                                            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 bg-danger rounded-circle"
                                                    style="transform: translate(50%, -50%); width: 20px; height: 20px; font-size: 10px;"
                                                    @onclick="() => RemoveImage(currentIndex)">
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <p class="text-danger">@ErrorMessage</p>
                        }
                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="HideModal">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-plus"></i> @(isSaving ? "Adding..." : "Add Product")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============ VIEW PRODUCT MODAL ============ -->
