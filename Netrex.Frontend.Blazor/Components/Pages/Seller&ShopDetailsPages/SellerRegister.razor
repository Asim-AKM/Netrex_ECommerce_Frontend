@page "/sellerregister"
@rendermode InteractiveServer
<div class="ntx-reg-container">
    <div class="ntx-reg-card">
        <h2 class="ntx-reg-title">Become a Seller</h2>
        <p class="ntx-reg-subtitle">Create your store and start selling</p>

        <EditForm Model="@seller" OnValidSubmit="CreateStore">

            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Store Name</label>
                <InputText class="ntx-reg-input"
                           @bind-Value="seller.StoreName"
                           placeholder="Enter store name" />
            </div>

            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Store Description</label>
                <InputTextArea class="ntx-reg-textarea"
                               @bind-Value="seller.StoreDescription"
                               placeholder="Describe your store" />
            </div>

            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Shop Category</label>

                <InputSelect class="ntx-reg-select" @bind-Value="seller.CategoryName">
                    <option value="">Select category</option>

                    @if (ShopDetails != null && ShopDetails.Any())
                    {
                        @foreach (var cat in ShopDetails)
                        {
                            @* value mein shop ki ID aur display mein shop ka naam *@
                            <option value="@cat.ShopId.ToString()">@cat.ShopName</option>
                        }
                    }
                    else
                    {
                        <option disabled>Loading categories...</option>
                    }
                </InputSelect>
            </div>

            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Store Address</label>
                <InputText class="ntx-reg-input"
                           @bind-Value="seller.Address"
                           placeholder="Enter store address" />
            </div>

            <button type="button"
                    class="ntx-reg-btn-submit"
                    onclick="window.location.href='/seller/plan';">
                Create Store
            </button>

        </EditForm>
    </div>
</div>

