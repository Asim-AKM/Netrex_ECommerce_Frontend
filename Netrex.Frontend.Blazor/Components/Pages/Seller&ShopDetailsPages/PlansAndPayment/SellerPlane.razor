@page "/seller/plan"
@inject NavigationManager NavManager

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-brand-dark">Choose Your Selling Plan</h2>
        <p class="lead text-muted">Unlock the full potential of your business with flexible pricing.</p>
    </div>

    <div class="row g-4 mb-5 justify-content-center">
        <div class="col-md-4">
            <div class="card h-100 plan-card p-4">
                <div class="card-body text-center d-flex flex-column">
                    <h3 class="h5">Starter</h3>
                    <div class="price-value">$29<span class="fs-6 fw-normal text-muted">/mo</span></div>
                    <ul class="list-unstyled my-4 text-start">
                        <li class="mb-2">✓ List 50 Products</li>
                        <li class="mb-2">✓ Basic Analytics</li>
                        <li class="mb-2">✓ Standard Support</li>
                    </ul>
                    @* Link inserted here *@
                    <button class="btn btn-outline-dark w-100 mt-auto" @onclick='() => NavigateToPayment("Starter", 29)'>
                        Get Started
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 plan-card featured p-4 shadow-lg border-primary" style="position: relative;">
                <div class="position-absolute top-0 start-50 translate-middle">
                    <span class="badge rounded-pill bg-info px-3 py-2">MOST POPULAR</span>
                </div>
                <div class="card-body text-center d-flex flex-column">
                    <h3 class="h5 mt-2">Growth</h3>
                    <div class="price-value">$149<span class="fs-6 fw-normal text-muted">/6 mo</span></div>
                    <small class="text-success fw-bold">Save $25 vs Monthly</small>
                    <ul class="list-unstyled my-4 text-start">
                        <li class="mb-2">✓ List 500 Products</li>
                        <li class="mb-2">✓ Priority Support</li>
                        <li class="mb-2">✓ Marketing Tools</li>
                    </ul>
                    @* Link inserted here *@
                    <button class="btn btn-primary w-100 mt-auto" @onclick='() => NavigateToPayment("Growth", 149)'>
                        Choose Plan
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 plan-card p-4">
                <div class="card-body text-center d-flex flex-column">
                    <h3 class="h5">Professional</h3>
                    <div class="price-value">$249<span class="fs-6 fw-normal text-muted">/yr</span></div>
                    <small class="text-success fw-bold">Best Value</small>
                    <ul class="list-unstyled my-4 text-start">
                        <li class="mb-2">✓ Unlimited Listings</li>
                        <li class="mb-2">✓ SEO Tools</li>
                        <li class="mb-2">✓ Account Manager</li>
                    </ul>
                    @* Link inserted here *@
                    <button class="btn btn-outline-dark w-100 mt-auto" @onclick='() => NavigateToPayment("Professional", 249)'>
                        Go Pro
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void NavigateToPayment(string planName, decimal price)
    {
        NavManager.NavigateTo($"/paymentdetail?plan={planName}&price={price}");
    }
}