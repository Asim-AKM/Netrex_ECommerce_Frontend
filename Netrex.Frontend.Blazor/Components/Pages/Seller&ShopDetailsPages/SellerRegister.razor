@page "/sellerregister"
@rendermode InteractiveServer

<div class="ntx-reg-container">
    <div class="ntx-reg-card">
        <h2 class="ntx-reg-title">Become a Seller</h2>

        <EditForm Model="@seller" OnValidSubmit="HandleRegistration" FormName="SellerRegForm">
            <DataAnnotationsValidator />
            <!-- Store Name -->
            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Store Name</label>
                <InputText class="ntx-reg-input" @bind-Value="seller.StoreName"
                           placeholder="Enter store name" />
                <ValidationMessage For="@(() => seller.StoreName)" class="text-danger" />
            </div>

            <!-- Store Description -->
            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Store Description</label>
                <InputTextArea class="ntx-reg-textarea" @bind-Value="seller.StoreDescription" placeholder="Describe your store" />
                <ValidationMessage For="@(() => seller.StoreDescription)" class="text-danger" />
            </div>

            <!-- Shop Category (Lazy Load) -->
            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Shop Category</label>
                <InputSelect class="ntx-reg-select"
                             @bind-Value="seller.ShopId"
                             @onfocus="LoadCategoriesAsync"
                             disabled="@isLoadingCategories">

                    <option value="">-- Select category --</option>

                    @foreach (var cat in ShopDetails)
                    {
                        <option value="@cat.ShopId.ToString()">@cat.ShopName</option>
                    }
                </InputSelect>

                <ValidationMessage For="@(() => seller.ShopId)" class="text-danger" />

                @if (isLoadingCategories)
                {
                    <div class="text-primary mt-1">🔄 Loading categories...</div>
                }
            </div>

            <!-- Store Address -->
            <div class="ntx-reg-field">
                <label class="ntx-reg-label">Store Address</label>

                <InputText class="ntx-reg-input"
                           @bind-Value="seller.Address" placeholder="Enter store address" />
                <ValidationMessage For="@(() => seller.Address)" class="text-danger" />

            </div>
            <button type="submit" class="ntx-reg-btn-submit">Create Store</button>
        </EditForm>
    </div>
</div>