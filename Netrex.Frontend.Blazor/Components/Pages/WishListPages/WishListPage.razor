@page "/wishlist"
@using Netrex.Frontend.Application.ViewModels.WishList
@using Netrex.Frontend.Application.Services.WishList
@inherits AuthComponentBase

<div class="wish-container mb-5">
    <div class="mx-auto" style="max-width: 1100px;">

        @* {{-- Header --}} *@
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <span class="text-muted small">(@Products.Count ITEMS)</span>
            </div>
            <button class="btn btn-custom px-4">SHARE WISHLIST</button>
        </div>

        @* {{-- Loading --}} *@
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-info" role="status"></div>
                <p class="text-muted mt-3">Loading your wishlist...</p>
            </div>
        }


        @* {{-- Empty --}} *@
        else if (!Products.Any())
        {
            <div class="text-center py-5">
                <span style="font-size:60px;">🤍</span>
                <p class="fw-bold text-secondary mt-3">Your Wishlist is Empty!</p>
                <button class="btn btn-custom px-5 mt-2">CONTINUE SHOPPING</button>
            </div>
        }

        @* {{-- Products Grid --}} *@
        else
        {
            <div class="row g-4">
                @foreach (var p in Products)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card text-center">

                            <div class="img-wrapper">
                                <img src="@(p.ImageUrl ?? "images/placeholder.png")"
                                     class="img-fluid"
                                     alt="@p.ProductName" />
                            </div>

                            <h6 class="fw-bold text-truncate mt-3">@p.ProductName</h6>
                            <p class="text-muted small mb-2 text-truncate">@p.ProductDescription</p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                @if (p.Discount > 0)
                                {
                                    <div>
                                        <span class="text-decoration-line-through text-muted small">
                                            Rs. @p.Price
                                        </span>
                                        <span class="text-info fw-bold small d-block">
                                            Rs. @(p.Price - (p.Price * p.Discount / 100))
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-info fw-bold small">Rs. @p.Price</span>
                                }

                                <span class="text-danger fs-5"
                                      style="cursor:pointer"
                                      @onclick="() => AskDelete(p.WishListItemId)">❤</span>
                            </div>

                        </div>
                    </div>
                }
            </div>

            <hr class="mt-5 mb-4 border-secondary border-dashed" />

            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="text-info fs-3 me-2">♥</span>
                    <span class="fw-bold text-secondary">Your Wishlist is Lonely!</span>
                </div>
                <button class="btn btn-custom px-5 py-2 mt-2 mt-md-0">
                    CONTINUE SHOPPING
                </button>
            </div>
        }
    </div>
</div>

@if (ShowPopup)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); backdrop-filter:blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg wish-modal">

                @* Header *@
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Remove Item?</h5>
                    <button type="button" class="btn-close" @onclick="HidePopup"></button>
                </div>

                @* Body *@
                <div class="modal-body text-center py-3">
                    <span style="font-size:50px;">🗑️</span>
                    <p class="text-muted mt-3 mb-0">
                        Are you sure you want to remove this item from your wishlist?
                    </p>
                </div>

                @* Footer *@
                <div class="modal-footer border-0 d-flex gap-2">
                    @if (isDeleting)
                    {
                        <div class="w-100 text-center py-1">
                            <div class="spinner-border text-danger" role="status"></div>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-light rounded-pill flex-grow-1 fw-bold border"
                                @onclick="HidePopup">
                            Cancel
                        </button>
                        <button class="btn btn-danger rounded-pill flex-grow-1 fw-bold"
                                @onclick="ConfirmDelete">
                            Yes, Remove
                        </button>
                    }
                </div>

            </div>
        </div>
    </div>
}


