<!-- Add Product Modal -->
@inject IProductManager ProductManager

@if (IsModalVisible)
{
    <!-- Modal Backdrop -->
    <div class="modal-backdrop fade show"></div>

    <!-- Add Product Modal -->
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Product</h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>

                <div class="modal-body">
                    <EditForm Model="_model" OnValidSubmit="SaveProduct">
                        <DataAnnotationsValidator />

                        <!-- Product Name -->
                        <div class="form-group mb-2">
                            <label>Product Name <span class="image-required">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.ProductName" />
                        </div>

                        <!-- Description -->
                        <div class="form-group mb-2">
                            <label>Description <span class="image-required">*</span></label>
                            <InputText class="form-control" @bind-Value="_model.ProductDescription" />
                        </div>

                        <!-- Price -->
                        <div class="form-group mb-2">
                            <label>Price <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.Price" step="0.01" />
                        </div>

                        <!-- Discount -->
                        <div class="form-group mb-2">
                            <label>Discount (%) <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.Discount" step="0.01" />
                        </div>

                        <!-- Category -->
                        <div class="form-group mb-2">
                            <label>Category <span class="image-required">*</span></label>
                            <InputSelect class="form-control" @bind-Value="_model.CategoryName">
                                <option value="">-- Select Category --</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Clothing">Clothing</option>
                                <option value="Books">Books</option>
                                <option value="Sports">Sports</option>
                                <option value="Home & Kitchen">Home & Kitchen</option>
                            </InputSelect>
                        </div>

                        <!-- Stock -->
                        <div class="form-group mb-2">
                            <label>Stock <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.StockQuantity" />
                        </div>

                        <!-- Images -->
                        <div class="form-group mb-2">
                            <label>Product Images (Max 5, 2.5MB each)</label>
                            <InputFile OnChange="OnImagesSelected" multiple />
                            @if (ImagePreviews.Any())
                            {
                                <div class="image-preview mt-2 d-flex flex-wrap">
                                    @for (int i = 0; i < ImagePreviews.Count; i++)
                                    {
                                        <div class="position-relative me-2 mb-2">
                                            <img src="@ImagePreviews[i]" style="width:90px;" class="rounded" />
                                            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0"
                                                    style="transform: translate(50%, -50%);"
                                                    @onclick="@(() => RemoveImage(i))"></button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Error -->
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <p class="text-danger">@ErrorMessage</p>
                        }

                        <button class="btn-primary mt-2" type="submit">
                            <i class="fas fa-plus"></i> Add Product
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Success Modal -->
@if (IsSuccessModalVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content border-success">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Success</h5>
                    <button type="button" class="btn-close" @onclick="HideSuccessModal"></button>
                </div>
                <div class="modal-body">
                    <p>@Message</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool IsModalVisible = false;
    private bool IsSuccessModalVisible = false;

    ProductsVm _model = new();
    List<byte[]> ImageBytesList = new();
    List<string> ImageNames = new();
    List<string> ImagePreviews = new();

    string? ErrorMessage;
    string Message = "";

    const long MaxFileSize = 2_621_440;
    const int MaxFiles = 5;

    void ShowModal() => IsModalVisible = true;
   

    void HideModal()
    {
        IsModalVisible = false;
        _model = new ProductsVm();
        ImageBytesList.Clear();
        ImageNames.Clear();
        ImagePreviews.Clear();
        ErrorMessage = null;
    }

    void HideSuccessModal()
    {
        IsSuccessModalVisible = false;
        Message = "";
    }

    void RemoveImage(int index)
    {
        if (index >= 0 && index < ImageBytesList.Count)
        {
            ImageBytesList.RemoveAt(index);
            ImageNames.RemoveAt(index);
            ImagePreviews.RemoveAt(index);
        }
    }

    async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var files = e.GetMultipleFiles(MaxFiles);

        if (files.Count + ImageBytesList.Count > MaxFiles)
        {
            ErrorMessage = $"Maximum {MaxFiles} images allowed.";
            return;
        }

        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                ErrorMessage = $"Image {file.Name} is larger than 2.5MB.";
                continue;
            }

            using var stream = file.OpenReadStream(MaxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            ImageBytesList.Add(ms.ToArray());
            ImageNames.Add(file.Name);
            ImagePreviews.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}");
        }
    }

    async Task SaveProduct()
    {
        if (!ImageBytesList.Any())
        {
            ErrorMessage = "Please upload at least one image.";
            return;
        }

        var result = await ProductManager.AddProducts(_model, ImageBytesList, ImageNames);

        if (result.IsSuccess)
        {
            Message = "Product saved successfully ✅";
            HideModal(); // original add modal close
            IsSuccessModalVisible = true; // success modal open
        }
        else
        {
            ErrorMessage = result.Message ?? "Something went wrong ❌";
        }
    }
}






