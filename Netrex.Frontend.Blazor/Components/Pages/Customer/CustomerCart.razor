@page "/customer/cart"
@using Netrex.Frontend.Blazor.Components.Layout.CustomerLayout
@layout CustomerMainLayout

<div class="customer-card">
    <div class="customer-card-header">
        <h5 class="customer-card-title">Shopping Cart</h5>
    </div>
    <div class="customer-card-body">
        <div class="customer-cart-items">
            <div class="customer-order-card mb-3 p-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6>Wireless Mouse</h6>
                        <p class="text-muted mb-1">Quantity: 1 × $25.99</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>$25.99</strong>
                        <button class="btn customer-btn-outline btn-sm ms-2 customer-remove-item" data-id="1">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="customer-order-card mb-3 p-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6>USB-C Cable</h6>
                        <p class="text-muted mb-1">Quantity: 2 × $9.99</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>$19.98</strong>
                        <button class="btn customer-btn-outline btn-sm ms-2 customer-remove-item" data-id="2">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="customer-order-card p-3">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6>Laptop Stand</h6>
                        <p class="text-muted mb-1">Quantity: 1 × $45.00</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>$45.00</strong>
                        <button class="btn customer-btn-outline btn-sm ms-2 customer-remove-item" data-id="3">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Empty cart message (initially hidden) -->
        <div class="text-center py-4 customer-empty-cart" style="display: none;">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
            <p>Your cart is empty</p>
            <button class="btn customer-btn-primary" data-section="dashboard">Continue Shopping</button>
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-4">
            <h5 class="customer-total-amount">Total: $<span id="spCartTotal">90.97</span></h5>
            <button class="btn customer-btn-primary">Checkout</button>
        </div>
    </div>
</div>